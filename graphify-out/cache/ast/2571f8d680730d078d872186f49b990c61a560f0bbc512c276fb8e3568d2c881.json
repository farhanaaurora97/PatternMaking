  },\n                font:      { weight: '600', size: 11, family: font },\n                formatter: (v) => (v > 0 ? String(v) : ''),\n              };\n            }\n            return base;\n          })", "is_member_call": false, "source_file": "E:\\Code\\PatternMaking\\Pattern.Web\\wwwroot\\js\\dashboard-charts.js", "source_location": "L377"}, {"caller_nid": "js_dashboard_charts_runfrompayload", "callee": "getElementById", "is_member_call": true, "source_file": "E:\\Code\\PatternMaking\\Pattern.Web\\wwwroot\\js\\dashboard-charts.js", "source_location": "L428"}, {"caller_nid": "js_dashboard_charts_runfrompayload", "callee": "stringify", "is_member_call": true, "source_file": "E:\\Code\\PatternMaking\\Pattern.Web\\wwwroot\\js\\dashboard-charts.js", "source_location": "L430"}, {"caller_nid": "js_dashboard_charts_refreshdashboardcharts", "callee": "fetch", "is_member_call": false, "source_file": "E:\\Code\\PatternMaking\\Pattern.Web\\wwwroot\\js\\dashboard-charts.js", "source_location": "L438"}, {"caller_nid": "js_dashboard_charts_refreshdashboardcharts", "callee": "json", "is_member_call": true, "source_file": "E:\\Code\\PatternMaking\\Pattern.Web\\wwwroot\\js\\dashboard-charts.js", "source_location": "L440"}]}