<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PatternPro.Web</RootNamespace>
    <AssemblyName>PatternPro.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PatternPro.Web.Model\PatternPro.Web.Model.csproj" />
    <ProjectReference Include="..\PatternPro.Business\PatternPro.Business.csproj" />
    <ProjectReference Include="..\PatternPro.DataAccess\PatternPro.DataAccess.csproj" />
    <ProjectReference Include="..\Pattern.Core.Model\Pattern.Core.Model.csproj" />
  </ItemGroup>

  <!-- Orphan Pattern.Web.Model.dll (May 2026) shadowed PatternPro.Web.Model types at runtime. -->
  <Target Name="RemoveStalePatternWebModelDll" AfterTargets="Build">
    <Delete Files="$(OutputPath)Pattern.Web.Model.dll;$(OutputPath)Pattern.Web.Model.pdb" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

