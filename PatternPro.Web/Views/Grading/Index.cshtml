@model GradingViewModel
@{ ViewData["Title"] = "Grading"; }

<div class="patternpro-dashboard grading-page">
  <header class="dash-header">
    <div class="dash-header__main">
      <div class="dash-eyebrow"><span class="dash-eyebrow__rule"></span> Grade rules</div>
      <h1 class="dash-title">Grading</h1>
      <p class="dash-sub">@Model.StyleLabel · delta from <strong>M</strong> base · values in cm</p>
    </div>
    <div class="dash-header__aside">
      <div class="dash-kpi-strip" aria-label="Grading summary">
        <div class="dash-kpi stat-card">
          <div class="dash-kpi__val">@Model.ColumnLabels.Count</div>
          <div class="dash-kpi__label">Sizes</div>
          <div class="dash-kpi__meta">XS–XXL</div>
        </div>
        <div class="dash-kpi__div" aria-hidden="true"></div>
        <div class="dash-kpi stat-card">
          <div class="dash-kpi__val">@Model.Rows.Count</div>
          <div class="dash-kpi__label">Points</div>
          <div class="dash-kpi__meta">POM rows</div>
        </div>
        <div class="dash-kpi__div" aria-hidden="true"></div>
        <div class="dash-kpi stat-card">
          <div class="dash-kpi__val">M</div>
          <div class="dash-kpi__label">Base</div>
          <div class="dash-kpi__meta">Always zero</div>
        </div>
      </div>
      <div class="dash-header__actions">
        <a class="btn-dash btn-dash--ghost" asp-controller="Home" asp-action="Index">Dashboard</a>
        <a class="btn-dash btn-dash--ghost"
           asp-controller="Grading" asp-action="ExportCsv"
           asp-route-style="@Model.StyleKey">Export CSV</a>
        <button type="button" class="btn-dash btn-dash--ghost" id="btn-add-row">+ Row</button>
        <button type="button" class="btn-dash btn-dash--primary" id="btn-add-col">+ Size</button>
      </div>
    </div>
  </header>

  @{
    var fits = new[]
    {
      ("skinny",   "Skinny"),
      ("slim",     "Slim"),
      ("straight", "Straight"),
      ("bootcut",  "Bootcut"),
      ("wideLeg",  "Wide Leg"),
    };
  }
  <nav class="gr-fit-tabs fit-tabs" aria-label="Fit switcher">
    @foreach (var (key, label) in fits)
    {
      <a class="fit-tab @(Model.StyleKey == key ? "active" : "")"
         asp-controller="Grading" asp-action="Index" asp-route-style="@key">@label</a>
    }
  </nav>

  <div class="tbl-wrap tbl-wrap--primary gr-table-wrap">
    <div class="tbl-toolbar">
      <div class="tbl-toolbar__row">
        <span class="tbl-label">Grade rules — @Model.StyleLabel</span>
        <span class="gr-unit-badge">DELTA · CM</span>
        <span class="gr-table-hint">Click cells to edit · changes save on blur</span>
      </div>
    </div>
    <div class="gr-table-scroll">
      <table class="gr-table">
        <thead>
          <tr>
            <th class="gr-col-point">Measurement point</th>
            @for (var i = 0; i < Model.ColumnLabels.Count; i++)
            {
              var col = Model.ColumnLabels[i];
              var isBase = i == Model.BaseIndex;
              <th class="gr-col-size @(isBase ? "sch-m gr-col-base" : null)">
                <div class="gr-col-head">
                  <span>@col@if (isBase) { <span class="gr-base-tag">Base</span> }</span>
                  @if (!isBase)
                  {
                    <button type="button" class="gr-del-btn" data-action="delete-column" data-col="@i" data-label="@col" title="Delete size @col" aria-label="Delete size @col">×</button>
                  }
                </div>
              </th>
            }
            <th class="gr-col-actions">Row</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in Model.Rows)
          {
            <tr>
              <td class="td-bold gr-col-point">@row.MeasurementPoint</td>
              @for (var i = 0; i < row.Deltas.Count; i++)
              {
                if (i == row.BaseIndex)
                {
                  <td class="gr-cell-base sch-m">0</td>
                }
                else
                {
                  var delta = row.Deltas[i];
                  <td class="gr-col-size gr-cell-delta @(delta < 0 ? "gr-cell-dn" : delta > 0 ? "gr-cell-up" : null)">
                    <input type="number" class="gr-delta-input"
                           step="0.1"
                           data-style="@Model.StyleKey" data-measurement="@row.MeasurementPoint" data-col="@i"
                           value="@delta.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           aria-label="@row.MeasurementPoint @Model.ColumnLabels[i] delta cm" />
                  </td>
                }
              }
              <td class="gr-col-actions">
                <button type="button" class="gr-del-btn gr-del-btn--row" data-action="delete-row" data-measurement="@row.MeasurementPoint" title="Delete @row.MeasurementPoint">Delete</button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  <details class="dash-analytics" id="gr-grading-guide">
    <summary class="dash-analytics__toggle">Grading guide</summary>
    <div class="dash-analytics__body gr-guide">
      <div class="gr-guide__grid">
        <div class="gr-guide__item">
          <strong>Fit profiles</strong>
          <span>Each fit (Skinny, Slim, etc.) has its own grade table. Switch tabs above — columns are shared across fits.</span>
        </div>
        <div class="gr-guide__item">
          <strong>M base</strong>
          <span>Medium is the reference size. All other sizes show the cm increment (+/−) from M.</span>
        </div>
        <div class="gr-guide__item">
          <strong>Adding sizes</strong>
          <span>New columns extrapolate from the last two sizes. Base size <em>M</em> cannot be removed.</span>
        </div>
        <div class="gr-guide__item">
          <strong>Delete</strong>
          <span>Use × on a size column or <em>Delete</em> on a row. At least one row and one size must remain.</span>
        </div>
      </div>
    </div>
  </details>
</div>

<div class="modal-overlay" id="modal-add-row">
  <div class="modal">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:6px">
      <div class="modal-title">Add measurement row</div>
      <button class="modal-close-btn" id="modal-add-row-close" type="button" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="modal-sub">A new measurement point row will be added to the <strong>@Model.StyleLabel</strong> grading table.</div>
    <div id="add-row-error" class="modal-error"></div>
    <div class="form-field">
      <label class="form-label" for="row-label">Measurement point <span class="req">*</span></label>
      <input class="form-input" id="row-label" placeholder="e.g. Thigh width" maxlength="64" autocomplete="off" />
    </div>
    <div class="form-field">
      <label class="form-label" for="row-copy-from">Copy deltas from <span style="font-weight:400;color:var(--ink4)">(optional)</span></label>
      <select class="form-input" id="row-copy-from">
        <option value="">— blank (all zeros) —</option>
        @foreach (var row in Model.Rows)
        {
          <option value="@row.MeasurementPoint">@row.MeasurementPoint</option>
        }
      </select>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn btn-outline btn-sm" id="modal-add-row-cancel">Cancel</button>
      <button type="button" class="btn btn-primary btn-sm" id="row-submit">Add row</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-add-col">
  <div class="modal">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:6px">
      <div class="modal-title">Add size column</div>
      <button class="modal-close-btn" id="modal-add-col-close" type="button" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="modal-sub">A new column will be appended to all fit grading tables, with deltas extrapolated from the last two sizes.</div>
    <div id="add-col-error" class="modal-error"></div>
    <div class="form-field">
      <label class="form-label" for="col-label">Size label <span class="req">*</span></label>
      <input class="form-input" id="col-label" placeholder="e.g. 3XL" maxlength="8" autocomplete="off" />
      <div style="font-size:11px;color:var(--ink4);margin-top:5px">Will be converted to uppercase (e.g. 3XL)</div>
    </div>
    <div class="col-preview" id="col-preview">
      <div class="col-preview-label">Preview — column order after adding</div>
      <div class="col-preview-chips" id="col-preview-chips">
        @for (var ci = 0; ci < Model.ColumnLabels.Count; ci++)
        {
          <span class="size-chip @(ci == Model.BaseIndex ? "size-chip--base" : "")">@Model.ColumnLabels[ci]</span>
        }
        <span class="size-chip size-chip--new" id="col-preview-new" style="display:none">—</span>
      </div>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn btn-outline btn-sm" id="modal-add-col-cancel">Cancel</button>
      <button type="button" class="btn btn-primary btn-sm" id="col-submit">Add column</button>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    window.__gradingStyleKey = '@Model.StyleKey';
  </script>
  <script src="~/js/grading.js" asp-append-version="true"></script>
}
