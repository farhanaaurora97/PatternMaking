@model ExportViewModel
@using Pattern.Core.Model
@{ ViewData["Title"] = "Export / DXF"; }

<div class="page-hdr">
  <div>
    <div class="page-title">Export Pattern</div>
    <div class="page-sub">Choose format and destination for your pattern files</div>
    @if (string.Equals((string?)ViewBag.ExportSource, "draft", StringComparison.OrdinalIgnoreCase))
    {
      <div class="tag tag-purple" style="margin-top:6px;display:inline-flex">Draft sizes from canvas loaded</div>
    }
    @if (Model.PatternId > 0)
    {
      <div class="tag tag-purple" style="margin-top:6px;display:inline-flex;margin-left:6px" title="One fit per factory ZIP — use Dashboard to export other styles">
        @Model.PatternDisplayName · @Model.StyleLabel
      </div>
    }
  </div>
</div>

<div class="export-grid">
  @foreach (var fmt in ExportViewModel.Formats)
  {
    <div class="export-card @(fmt.Name == Model.SelectedFormat ? "selected" : "")"
         data-format="@fmt.Name">
      <div class="exp-icon">@fmt.Icon</div>
      <div class="exp-name">@fmt.Name</div>
      <div class="exp-desc">@fmt.Description</div>
      @if (fmt.Recommended)
      {
        <div style="margin-top:14px"><span class="tag tag-green">Recommended</span></div>
      }
    </div>
  }
</div>

<div class="card" id="production-qc-card" style="margin-bottom:20px">
  <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
    <span>Production QC — Factory floor</span>
    <span class="tag @(Model.CanExportToFactory ? "tag-green" : "tag-gold")" id="qc-status-tag">
      @(Model.CanExportToFactory ? "Ready for factory" : "Not production certified")
    </span>
  </div>
  @if (Model.CanExportToFactory)
  {
    <p style="margin:10px 0 0;font-size:13px;color:#166534;font-weight:600">
      Factory ZIP is ready — scroll down and click <strong>↓ Factory export</strong> to download for the cutting room.
    </p>
  }
  <p style="font-size:12.5px;color:var(--ink3);margin:0 0 14px">
    Factory CAM export requires QC pass, design approval, and a recorded cutter/plotter test on real equipment.
  </p>
  <div class="grid-2" style="gap:16px;margin-bottom:14px">
    <div>
      <div class="cp-row" style="margin-bottom:8px">
        <span style="font-size:13px;color:var(--ink3)">Design approval</span>
        <span class="tag @(Model.ApprovedForCutting ? "tag-green" : "tag-purple")" id="qc-approved-tag">
          @(Model.ApprovedForCutting ? "Approved" : "Pending")
        </span>
      </div>
      @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
      {
        <div style="font-size:12px;color:var(--ink3)" id="qc-approved-by">By @Model.ApprovedBy</div>
      }
      <div class="row" style="gap:8px;margin-top:10px;flex-wrap:wrap">
        <button type="button" class="btn btn-gold btn-sm" id="btn-approve-cutting" @(Model.PatternId <= 0 ? "disabled" : null)>Approve for cutting</button>
        <button type="button" class="btn btn-outline btn-sm" id="btn-revoke-approval" @(Model.PatternId <= 0 || !Model.ApprovedForCutting ? "disabled" : null)>Revoke</button>
      </div>
    </div>
    <div>
      <div class="cp-row" style="margin-bottom:8px">
        <span style="font-size:13px;color:var(--ink3)">Cutter / plotter test</span>
        <span class="tag @(Model.CutterTestPassed ? "tag-green" : "tag-purple")" id="qc-cutter-tag">
          @(Model.CutterTestPassed ? "Passed" : "Not recorded")
        </span>
      </div>
      @if (!string.IsNullOrWhiteSpace(Model.CutterTestedBy))
      {
        <div style="font-size:12px;color:var(--ink3)" id="qc-cutter-by">By @Model.CutterTestedBy</div>
      }
      <div class="row" style="gap:8px;margin-top:10px;flex-wrap:wrap">
        <button type="button" class="btn btn-gold btn-sm" id="btn-cutter-pass" @(Model.PatternId <= 0 ? "disabled" : null)>Record pass</button>
        <button type="button" class="btn btn-outline btn-sm" id="btn-cutter-fail" @(Model.PatternId <= 0 ? "disabled" : null)>Record fail</button>
      </div>
    </div>
  </div>
  <div class="cp-row" style="margin-bottom:12px;max-width:360px;gap:10px">
    <label for="shrinkage-pct" style="font-size:13px;color:var(--ink2);font-weight:500">Shrinkage %</label>
    <input type="number" id="shrinkage-pct" min="0" max="15" step="0.5" value="@Model.ShrinkagePercent.ToString("0.#")"
           style="width:72px;border:1px solid var(--bdr2);border-radius:var(--r);padding:5px 8px;font-size:12.5px" />
    <button type="button" class="btn btn-outline btn-sm" id="btn-save-shrinkage">Save</button>
  </div>
  <div class="row" style="gap:8px;margin-bottom:14px;flex-wrap:wrap">
    <button type="button" class="btn btn-gold" id="btn-complete-certification" @(Model.PatternId <= 0 ? "disabled" : null)
            title="Apply 1 cm seam allowance on cut pieces, approve for cutting, and confirm cutter test">
      Prepare &amp; certify for factory
    </button>
  </div>
  <div id="qc-issues-list" style="font-size:12.5px">
    @{
      var issues = ViewBag.ValidationIssues as IReadOnlyList<ProductionValidationIssue>;
      var warnings = ViewBag.ValidationWarnings as IReadOnlyList<ProductionValidationIssue>;
    }
    @if (issues is { Count: > 0 })
    {
      <div style="color:#b91c1c;margin-bottom:8px;font-weight:600">Blocking issues</div>
      <ul style="margin:0;padding-left:18px;color:#b91c1c" id="qc-errors-ul">
        @foreach (var i in issues)
        {
          <li>@i.Message @if (!string.IsNullOrWhiteSpace(i.Detail)) { <span style="color:var(--ink3)">— @i.Detail</span> }</li>
        }
      </ul>
    }
    @if (warnings is { Count: > 0 })
    {
      <div style="color:var(--ink2);margin-top:10px;font-weight:600">Warnings</div>
      <ul style="margin:4px 0 0;padding-left:18px;color:var(--ink3)" id="qc-warnings-ul">
        @foreach (var w in warnings)
        {
          <li>@w.Message</li>
        }
      </ul>
    }
    @if ((issues is null || issues.Count == 0) && (warnings is null || warnings.Count == 0) && Model.PatternId > 0)
    {
      <div style="color:var(--ink3)">No geometry QC issues — complete approval and cutter test to enable factory download.</div>
    }
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-title">Export Settings</div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <div class="cp-row">
        <span style="font-size:13px;color:var(--ink2);font-weight:500">Scale</span>
        <select style="border:1px solid var(--bdr2);border-radius:var(--r);padding:5px 10px;font-family:'DM Sans',sans-serif;font-size:12.5px;color:var(--ink);background:#fff">
          <option>1:1 (Full Scale)</option>
          <option>1:4 (Quarter)</option>
          <option>1:5 (Fifth)</option>
          <option>1:10 (Tenth)</option>
        </select>
      </div>
      <div class="cp-row"><span style="font-size:13px;color:var(--ink2);font-weight:500">SA Included</span><button class="tog on" id="tog-sa-export"></button></div>
      <div class="cp-row"><span style="font-size:13px;color:var(--ink2);font-weight:500">Grain Line</span><button class="tog on" id="tog-grain-export"></button></div>
      <div class="cp-row"><span style="font-size:13px;color:var(--ink2);font-weight:500">Notches</span><button class="tog on" id="tog-notch-export"></button></div>
      <div class="cp-row"><span style="font-size:13px;color:var(--ink2);font-weight:500">Labels</span><button class="tog on" id="tog-labels-export"></button></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Export Summary</div>
    <div style="background:var(--cream);border-radius:var(--r2);padding:16px;border:1px solid var(--bdr);margin-bottom:16px">
      <div class="cp-row" style="margin-bottom:9px">
        <span style="font-size:13px;color:var(--ink3)">Pattern</span>
        <span style="font-size:13px;font-weight:600;color:var(--ink)" id="exp-pattern">@Model.PatternDisplayName</span>
      </div>
      <div class="cp-row" style="margin-bottom:9px">
        <span style="font-size:13px;color:var(--ink3)">Style</span>
        <span style="font-size:13px;font-weight:600;color:var(--ink)" id="exp-style">@Model.StyleLabel</span>
      </div>
      <div class="cp-row" style="margin-bottom:9px">
        <span style="font-size:13px;color:var(--ink3)">Pieces</span>
        <span style="font-size:13px;font-weight:600;color:var(--ink)" id="exp-pieces">
          @Model.PieceCount pieces × @Model.SizeCount sizes = @Model.TotalFiles files
        </span>
      </div>
      <div class="cp-row" style="margin-bottom:9px">
        <span style="font-size:13px;color:var(--ink3)">Sizes</span>
        <span style="font-size:13px;font-weight:600;color:var(--ink)">@Model.SizesCsv</span>
      </div>
      @if (!string.IsNullOrWhiteSpace(Model.CanvasGradeBaseSize))
      {
      <div class="cp-row" style="margin-bottom:9px">
        <span style="font-size:13px;color:var(--ink3)">Canvas master</span>
        <span style="font-size:13px;font-weight:600;color:var(--ink)" title="Saved canvas is treated as this size; other sizes are graded from it.">@Model.CanvasGradeBaseSize (grading ref.)</span>
      </div>
      }
      <div class="cp-row" style="margin-bottom:0">
        <span style="font-size:13px;color:var(--ink3)">Format</span>
        <span class="tag tag-green" id="exp-format">@Model.SelectedFormat</span>
      </div>
    </div>

    <div class="export-progress-wrap" id="export-progress-wrap">
      <div class="export-progress-bar-track">
        <div class="export-progress-bar-fill" id="export-bar"></div>
      </div>
      <div class="export-progress-text" id="export-progress-text">Preparing files...</div>
      <div class="export-steps" id="export-steps"></div>
    </div>

    <hr>
    <div class="row" style="justify-content:flex-end;flex-wrap:wrap;gap:8px">
      <button class="btn btn-outline" id="btn-preview">Preview</button>
      <button class="btn btn-outline" id="btn-download-clo" @(Model.PatternId <= 0 ? "disabled" : null)>CLO review ZIP</button>
      <button class="btn btn-outline" id="btn-download-draft" @(Model.PatternId <= 0 ? "disabled" : null)>Draft ZIP</button>
      <button class="btn btn-gold" style="padding:9px 22px;font-size:13px"
              id="btn-download-export"
              @(Model.PatternId > 0 && !Model.CanExportToFactory ? "disabled" : null)
              title="@(Model.CanExportToFactory ? "Production-certified factory export" : "Complete QC, approval, and cutter test first")">
        ↓ Factory export
      </button>
    </div>
  </div>
</div>

<iframe name="pp-export-dl" id="pp-export-dl" title="Export download"
        style="position:absolute;width:0;height:0;border:0;left:-9999px;visibility:hidden"
        aria-hidden="true"></iframe>

<div class="modal-overlay" id="preview-modal-overlay">
  <div class="modal modal-wide">
    <div class="modal-title">Export Preview</div>
    <div class="modal-sub" id="preview-modal-sub">Pattern pieces at base size — verify before export</div>
    <div id="preview-canvas-grid" class="preview-grid"></div>
    <div class="modal-actions">
      <button class="btn btn-outline" id="btn-preview-close">Close</button>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    window.EXPORT_URL       = '@Url.Action("StartExport", "Export")';
    window.EXPORT_TOTAL_FILES = @Model.TotalFiles;
    window.PREVIEW_URL      = '@Url.Action("PreviewPieces", "Export")';
    window.EXPORT_STYLE     = '@ViewBag.CurrentStyle';
    window.EXPORT_PATTERN_ID = @Model.PatternId;
    window.EXPORT_SIZES_CSV = '@Model.SizesCsv';
    window.DOWNLOAD_PACKAGE_URL = '@Url.Action("DownloadPackage", "Export")';
    window.VALIDATE_FACTORY_URL = '@Url.Action("ValidateFactory", "Export")';
    window.APPROVE_CUTTING_URL = '@Url.Action("ApproveForCutting", "Export")';
    window.REVOKE_APPROVAL_URL = '@Url.Action("RevokeApproval", "Export")';
    window.RECORD_CUTTER_URL = '@Url.Action("RecordCutterTest", "Export")';
    window.SET_SHRINKAGE_URL = '@Url.Action("SetShrinkage", "Export")';
    window.COMPLETE_CERTIFICATION_URL = '@Url.Action("CompleteFactoryCertification", "Export")';
    window.CAN_EXPORT_FACTORY = @(Model.CanExportToFactory ? "true" : "false");
  </script>
  <script src="~/js/export.js" asp-append-version="true"></script>
}
