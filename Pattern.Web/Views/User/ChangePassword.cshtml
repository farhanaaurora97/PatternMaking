@model global::Pattern.Web.Model.ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }

<div class="page-header">
  <div class="page-title">Change password</div>
  <div class="page-sub"><a asp-action="Index">← Back to my account</a></div>
</div>

<div class="card" style="padding:24px;max-width:480px">
  <form asp-action="ChangePassword" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="login-error" style="margin-bottom:16px"></div>

    <div class="form-row">
      <label class="form-label" asp-for="CurrentPassword"></label>
      <input class="form-input" asp-for="CurrentPassword" autocomplete="current-password" />
    </div>

    <div class="form-row">
      <label class="form-label" asp-for="NewPassword"></label>
      <input class="form-input" asp-for="NewPassword" autocomplete="new-password" />
    </div>

    <div class="form-row">
      <label class="form-label" asp-for="ConfirmPassword"></label>
      <input class="form-input" asp-for="ConfirmPassword" autocomplete="new-password" />
    </div>

    <button type="submit" class="btn btn-primary">Update password</button>
  </form>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
