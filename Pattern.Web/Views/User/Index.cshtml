@model global::Pattern.Web.Model.UserProfileViewModel
@{ ViewData["Title"] = "My account"; }

<div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
  <div>
    <div class="page-title">My account</div>
    <div class="page-sub">Employee profile and access</div>
  </div>
  <a class="btn btn-gold btn-sm" asp-controller="Home" asp-action="Index">Open patterns</a>
</div>

@if (TempData["UserMessage"] is string msg)
{
  <div class="card" style="padding:12px 16px;margin-bottom:16px;background:#ecfdf5;border-color:#a7f3d0;color:#065f46">@msg</div>
}

<div class="card" style="padding:24px;max-width:560px">
  <div style="display:grid;grid-template-columns:140px 1fr;gap:12px 16px;font-size:14px">
    <div style="color:var(--ink3)">Employee ID</div>
    <div style="font-weight:700;font-family:'DM Mono',monospace">@Model.EmployeeId</div>

    <div style="color:var(--ink3)">Full name</div>
    <div style="font-weight:600">@Model.DisplayName</div>

    <div style="color:var(--ink3)">Username</div>
    <div>@Model.UserName</div>

    <div style="color:var(--ink3)">Role</div>
    <div><span class="tag tag-purple">@Model.RoleLabel</span></div>

    <div style="color:var(--ink3)">Account status</div>
    <div>
      @if (Model.IsActive)
      {
        <span class="tag tag-green">Active</span>
      }
      else
      {
        <span class="tag tag-gold">Pending approval</span>
      }
    </div>

    <div style="color:var(--ink3)">Registered</div>
    <div>@Model.CreatedAt.ToLocalTime().ToString("g")</div>

    <div style="color:var(--ink3)">Last sign-in</div>
    <div>@(Model.LastLoginAt?.ToLocalTime().ToString("g") ?? "—")</div>
  </div>

  <div style="margin-top:24px;display:flex;gap:10px;flex-wrap:wrap">
    <a class="btn btn-outline btn-sm" asp-action="ChangePassword">Change password</a>
    <a class="btn btn-outline btn-sm" asp-controller="Home" asp-action="Index">Dashboard</a>
  </div>
</div>

<div class="card" style="padding:20px;margin-top:20px;max-width:560px">
  <div style="font-weight:700;margin-bottom:8px">What you can do</div>
  <ul style="margin:0;padding-left:18px;color:var(--ink2);font-size:13px;line-height:1.7">
    <li><strong>View only</strong> — browse patterns and exports (no save)</li>
    <li><strong>Pattern designer</strong> — edit canvas and factory export</li>
    <li><strong>Administrator</strong> — manage users in the admin panel</li>
  </ul>
  <div style="font-size:12px;color:var(--ink3);margin-top:10px">Role changes are made by an administrator.</div>
</div>
