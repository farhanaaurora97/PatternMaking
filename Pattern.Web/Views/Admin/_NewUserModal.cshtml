@model global::Pattern.Web.Model.AdminUserFormViewModel
@{
  var showModal = ViewData["ShowNewUserModal"] as bool? == true;
}

<div id="new-user-modal" class="modal-overlay @(showModal ? "open" : "")" role="presentation">
  <div class="modal admin-user-modal" role="dialog" aria-modal="true" aria-labelledby="new-user-title" onclick="event.stopPropagation()">
    <div class="modal-header">
      <div>
        <div class="modal-title" id="new-user-title">New user</div>
        <div class="modal-sub">Add an employee login for your team.</div>
      </div>
      <button type="button" class="modal-close-btn" aria-label="Close" data-new-user-close>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="modal-error show"></div>

      <div class="form-row">
        <label class="form-label" asp-for="EmployeeId"></label>
        <input class="form-input" asp-for="EmployeeId" autocomplete="off" placeholder="e.g. EMP-1042" />
      </div>
      <div class="form-row">
        <label class="form-label" asp-for="DisplayName"></label>
        <input class="form-input" asp-for="DisplayName" />
      </div>
      <div class="form-row">
        <label class="form-label" asp-for="UserName"></label>
        <input class="form-input" asp-for="UserName" autocomplete="off" />
      </div>
      <div class="form-row">
        <label class="form-label" asp-for="Role"></label>
        <select class="form-input" asp-for="Role">
          @foreach (var role in Pattern.Core.Model.AppRoles.All)
          {
            <option value="@role">@Pattern.Core.Model.AppRoles.Label(role)</option>
          }
        </select>
      </div>
      <div class="form-row">
        <label class="form-label" asp-for="Password"></label>
        <input class="form-input" asp-for="Password" autocomplete="new-password" />
      </div>
      <div class="form-row">
        <label class="form-label" asp-for="ConfirmPassword"></label>
        <input class="form-input" asp-for="ConfirmPassword" autocomplete="new-password" />
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-outline btn-sm" data-new-user-close>Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create user</button>
      </div>
    </form>
  </div>
</div>
