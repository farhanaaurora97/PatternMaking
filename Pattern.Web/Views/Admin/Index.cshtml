@model global::Pattern.Web.Model.AdminUsersViewModel
@using Pattern.Core.Model
@{ ViewData["Title"] = "User management"; }

<div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
  <div>
    <div class="page-title">Admin panel</div>
    <div class="page-sub">Manage employees, roles, and account approval.</div>
  </div>
  <a class="btn btn-gold btn-sm" asp-action="Create">+ New user</a>
</div>

@if (TempData["AdminMessage"] is string msg)
{
  <div class="card" style="padding:12px 16px;margin-bottom:16px;background:#ecfdf5;border-color:#a7f3d0;color:#065f46">@msg</div>
}
@if (TempData["AdminError"] is string err)
{
  <div class="card" style="padding:12px 16px;margin-bottom:16px;background:#fef2f2;border-color:#fecaca;color:#991b1b">@err</div>
}

<div class="card" style="padding:0;overflow:hidden">
  <table class="data-table" style="width:100%">
    <thead>
      <tr>
        <th>Employee</th>
        <th>Role</th>
        <th>Status</th>
        <th>Last login</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    @foreach (var u in Model.Users)
    {
      <tr>
        <td>
          <div style="font-weight:600">@u.DisplayName</div>
          <div style="font-size:12px;color:var(--ink3)">@u.EmployeeId · @u.UserName</div>
        </td>
        <td><span class="tag tag-purple">@u.RoleLabel</span></td>
        <td>
          @if (u.IsActive)
          {
            <span class="tag tag-green">Active</span>
          }
          else if (!u.LastLoginAt.HasValue)
          {
            <span class="tag tag-gold">Pending approval</span>
          }
          else
          {
            <span class="tag tag-red">Disabled</span>
          }
        </td>
        <td style="font-size:12px;color:var(--ink3)">@(u.LastLoginAt?.ToLocalTime().ToString("g") ?? "—")</td>
        <td style="text-align:right;white-space:nowrap">
          <a class="btn btn-outline btn-xs" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
          <form asp-action="ToggleActive" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@u.Id" />
            <input type="hidden" name="active" value="@(u.IsActive ? "false" : "true")" />
            <button type="submit" class="btn btn-outline btn-xs">@(u.IsActive ? "Disable" : "Approve")</button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
</div>

<div class="card" style="padding:20px;margin-top:20px">
  <div style="font-weight:700;margin-bottom:10px">Roles</div>
  <ul style="margin:0;padding-left:18px;color:var(--ink2);font-size:13px;line-height:1.7">
    <li><strong>Administrator</strong> — full access + this panel</li>
    <li><strong>Pattern designer</strong> — create/edit patterns, factory export</li>
    <li><strong>View only</strong> — browse screens; cannot save or export factory files</li>
    <li><strong>Disabled</strong> — cannot sign in</li>
  </ul>
</div>
