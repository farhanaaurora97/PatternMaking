@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="page-hdr">
  <div>
    <div class="page-title">Denim Pattern Module</div>
    <div class="page-sub">Bottom Wear — Jeans &amp; Denim Collection</div>
    <span class="tag tag-navy" id="dash-style-tag">✦ @Model.CurrentStyleLabel</span>
  </div>
  <div class="row">
    <button class="btn btn-outline" id="btn-duplicate">⊕ Duplicate Pattern</button>
    <a class="btn btn-primary" asp-controller="Canvas" asp-action="Index">⊞ Open in Canvas</a>
  </div>
</div>

<!-- Stats -->
<div class="grid-4">
  <div class="stat-card">
    <div class="stat-label">Active Patterns</div>
    <div class="stat-val" id="stat-active" data-target="@Model.ActivePatternCount">0</div>
    <div class="stat-delta delta-up">
      <span class="delta-icon up">↑</span>
      <span id="delta-active">@Model.ActivePatternCount total patterns</span>
    </div>
    <div class="stat-bar"><div class="stat-bar-fill" id="bar-active" style="width:0%"></div></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Sizes Graded</div>
    <div class="stat-val">6<span class="stat-unit">sz</span></div>
    <div class="stat-delta delta-info"><span class="delta-icon info">→</span>XS → XXL range</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width:100%"></div></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Pattern Pieces</div>
    <div class="stat-val" id="stat-pieces">@Model.PieceCount</div>
    <div class="stat-delta delta-info"><span class="delta-icon info">◈</span>per style</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width:75%"></div></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Completion</div>
    <div class="stat-val" id="stat-completion"
         data-target="@Model.CompletionPercent">0<span class="stat-unit">%</span></div>
    <div class="stat-delta delta-up"><span class="delta-icon up">↑</span>Grading done</div>
    <div class="stat-bar"><div class="stat-bar-fill" id="bar-completion" style="width:0%"
         data-target="@Model.CompletionPercent"></div></div>
  </div>
</div>

<!-- Style Progress + Activity -->
<div class="grid-2">
  <div class="card">
    <div class="card-title">Style Progress</div>
    @foreach (var (key, label) in new[] { ("skinny","Skinny"),("slim","Slim"),("straight","Straight"),("bootcut","Bootcut"),("wideleg","Wide Leg") })
    {
      var pct = Model.StyleProgress.GetValueOrDefault(key, 0);
      <div class="prog-row">
        <div class="prog-name">@label</div>
        <div class="prog-track">
          <div class="prog-fill" id="prog-@key" style="width:0%" data-target="@pct"></div>
        </div>
        <div class="prog-pct" id="pct-@key">@pct%</div>
      </div>
    }
  </div>
  <div class="card">
    <div class="card-title">Recent Activity</div>
    <div id="activity-feed">
      @foreach (var item in Model.RecentActivity)
      {
        <div class="act-row">
          <span class="act-badge @item.BadgeCss">@item.Badge</span>
          <div class="act-text">@item.Text</div>
          <div class="act-time">@item.TimeAgo</div>
        </div>
      }
    </div>
  </div>
</div>

<!-- Patterns Table -->
<div class="tbl-wrap">
  <div class="tbl-header">
    <span class="tbl-title">All Patterns</span>
    <div class="tbl-search">
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="5.5" cy="5.5" r="4" stroke="var(--ink4)" stroke-width="1.4"/><path d="M9 9l2.5 2.5" stroke="var(--ink4)" stroke-width="1.4" stroke-linecap="round"/></svg>
      <input type="text" id="tbl-search-input" placeholder="Search patterns..." />
    </div>
    <span class="tbl-count" id="tbl-count">@Model.Patterns.Count of @Model.Patterns.Count</span>
    <span class="spacer"></span>
    <button class="btn btn-outline btn-sm" id="btn-add-pattern">＋ Add</button>
  </div>
  <table>
    <thead>
      <tr>
        <th data-sort="name">Pattern Name <span class="sort-icon">↕</span></th>
        <th data-sort="style">Style <span class="sort-icon">↕</span></th>
        <th data-sort="base">Base Size <span class="sort-icon">↕</span></th>
        <th data-sort="pieces">Pieces <span class="sort-icon">↕</span></th>
        <th data-sort="status">Status <span class="sort-icon">↕</span></th>
        <th data-sort="date">Last Updated <span class="sort-icon">↕</span></th>
        <th></th>
      </tr>
    </thead>
    <tbody id="patterns-tbody">
      @foreach (var p in Model.Patterns)
      {
        <tr id="row-@p.Id">
          <td class="td-label">@p.DisplayName</td>
          <td class="td-mono">@p.Style</td>
          <td class="td-mono">@p.BaseSize</td>
          <td class="td-mono">@p.PieceCount</td>
          <td>
            <span class="status-tag @p.StatusCssClass"
                  data-action="cycle-status" data-id="@p.Id"
                  title="Click to change status">@p.StatusLabel</span>
          </td>
          <td class="td-mono" style="color:var(--ink3)">@p.Date</td>
          <td>
            <div style="display:flex;gap:6px">
              <a class="btn btn-outline btn-xs"
                 asp-controller="Canvas" asp-action="Index">Open</a>
              <button class="btn btn-danger btn-xs"
                      data-action="delete-pattern" data-id="@p.Id">✕</button>
            </div>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

<div style="font-size:11.5px;color:var(--ink4);text-align:center;margin-top:-10px">
  Tip: Click any <strong>status tag</strong> to cycle through statuses &nbsp;·&nbsp;
  <span class="kbd">N</span> New pattern
</div>

@section Scripts {
  <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
