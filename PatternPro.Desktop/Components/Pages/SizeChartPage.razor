@page "/module/size-chart"
@page "/module/size-chart/{PatternId:int}"
@attribute [Authorize]
@using CoreModel = Pattern.Core.Model
@using PatternPro.Desktop.Services
@inject ISizeChartService SizeChartService
@inject IPatternService PatternService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="gr-page size-chart-page">
    <header class="dash-header sc-dash-header">
        <div class="dash-header__main">
            <div class="dash-eyebrow"><span class="dash-eyebrow__rule"></span> Measurements</div>
            <h1 class="dash-title" style="margin:0">Size chart</h1>
            <p class="page-sub" style="margin:6px 0 0">@_snapshot.ScopeLabel · @_chartMode mode · unit cm · <strong>M</strong> base</p>
        </div>
        <div class="dash-header__aside">
            <div class="dash-kpi-strip">
                <div class="dash-kpi">
                    <div class="dash-kpi__val">@_columns.Count</div>
                    <div class="dash-kpi__label">Sizes</div>
                </div>
                <div class="dash-kpi__div"></div>
                <div class="dash-kpi">
                    <div class="dash-kpi__val">@_rows.Count</div>
                    <div class="dash-kpi__label">Points</div>
                </div>
            </div>
            <div class="dash-header__actions">
                <NavLink class="btn btn-outline btn-sm" href="">Dashboard</NavLink>
                <button type="button" class="btn btn-outline btn-sm" @onclick="ExportCsv" disabled="@_busy">Export CSV</button>
                <button type="button" class="btn btn-outline btn-sm" @onclick="OpenAddRowAsync">+ Measurement</button>
                <button type="button" class="btn btn-gold btn-sm" @onclick="OpenAddColAsync">+ Size</button>
            </div>
        </div>
    </header>

    <div class="sc-scope-bar ss-lifecycle-legend" style="margin-bottom:14px;padding:10px 14px">
        <div class="ss-lifecycle-legend__row" style="flex-wrap:wrap;gap:10px;align-items:center">
            <span class="ss-lifecycle-legend__label">Style scope</span>
            <div class="tbl-search" style="min-width:200px">
                <input type="search" placeholder="Search code or name…"
                       @bind="_scopeSearch" @bind:event="oninput"
                       @onkeydown="OnScopeSearchKeyDown" />
            </div>
            <select class="status-select" style="min-width:220px" @bind="_selectedPatternId" @bind:after="OnPatternChanged">
                <option value="0">Global (all styles)</option>
                @foreach (var p in FilteredPatterns)
                {
                    <option value="@p.Id">@p.Code — @p.Name</option>
                }
            </select>
            @if (!string.IsNullOrWhiteSpace(_scopeSearch))
            {
                <span class="tbl-count">@FilteredPatterns.Count() of @_patterns.Count</span>
            }
        </div>
        @if (_selectedPatternId > 0)
        {
            <div class="ss-lifecycle-legend__row" style="margin-top:10px;flex-wrap:wrap;gap:12px">
                <label style="display:flex;align-items:center;gap:6px;font-size:13px">
                    <input type="radio" name="chartMode" checked="@(_chartMode == CoreModel.MeasurementChartMode.Body)" @onchange="() => SetChartMode(CoreModel.MeasurementChartMode.Body)" />
                    Body (+ ease when generating)
                </label>
                <label style="display:flex;align-items:center;gap:6px;font-size:13px">
                    <input type="radio" name="chartMode" checked="@(_chartMode == CoreModel.MeasurementChartMode.Garment)" @onchange="() => SetChartMode(CoreModel.MeasurementChartMode.Garment)" />
                    Garment (finished POM — no ease)
                </label>
                <label style="display:flex;align-items:center;gap:6px;font-size:13px;margin-left:8px">
                    <input type="checkbox" @bind="_useCustomChart" @bind:after="OnCustomChartChanged" />
                    Custom chart for this style
                </label>
                <button type="button" class="btn btn-outline btn-sm" @onclick="CopyGlobalAsync" disabled="@_busy">Copy global → custom</button>
                <button type="button" class="btn btn-outline btn-sm" @onclick="LoadGarmentTemplateAsync" disabled="@_busy">Load garment template (BO, 36–54)</button>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert-error" style="margin-bottom:12px">@_message</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="pcs-success" style="margin-bottom:12px">@_success</div>
    }

    <div class="tbl-wrap tbl-wrap--primary sc-table-wrap">
        <div class="tbl-toolbar">
            <div class="tbl-toolbar__row">
                <span class="tbl-label">@(_chartMode == CoreModel.MeasurementChartMode.Garment ? "Garment POM" : "Body measurements")</span>
                <span class="sc-unit-badge">UNIT · CM</span>
                <span class="gr-hint sc-table-hint">Click cells to edit · ± tolerance shown</span>
            </div>
        </div>
        <div class="sc-table-scroll">
        <table class="sc-table">
            <thead>
                <tr>
                    <th>Point</th>
                    <th style="text-align:center">± cm</th>
                    <th>Method</th>
                    @for (var i = 0; i < _columns.Count; i++)
                    {
                        var col = _columns[i];
                        var colIdx = i;
                        var isBase = IsBaseColumn(col, i);
                        <th class="@(isBase ? "gr-col-base" : "")" style="text-align:center">
                            <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
                                <span>@col@(isBase ? " — Base" : "")</span>
                                @if (!isBase)
                                {
                                    <button type="button" class="pp-btn-delete" title="Delete size @col"
                                            @onclick="() => DeleteColumnAsync(colIdx, col)">×</button>
                                }
                            </div>
                        </th>
                    }
                    <th style="width:72px;text-align:center">Row</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td class="td-bold">@row.MeasurementPoint</td>
                        <td class="td-mono" style="text-align:center">
                            <input type="number" class="gr-delta-input" style="width:56px" step="0.1" min="0"
                                   value="@row.ToleranceCm.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   @onchange="e => OnToleranceChanged(row.MeasurementPoint, e)" />
                        </td>
                        <td>
                            <input type="text" class="gr-delta-input" style="min-width:180px;max-width:280px"
                                   value="@row.MeasurementMethod"
                                   @onchange="e => OnMethodChanged(row.MeasurementPoint, e)" />
                        </td>
                        @for (var i = 0; i < row.Values.Count; i++)
                        {
                            var col = i;
                            var isBase = IsBaseColumn(col < _columns.Count ? _columns[col] : "", col);
                            <td class="td-mono @(isBase ? "gr-cell-base" : "gr-cell-delta")">
                                <input type="number"
                                       class="gr-delta-input"
                                       step="0.1"
                                       value="@row.Values[col].ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       @onchange="e => OnCellChanged(row.MeasurementPoint, col, e)" />
                            </td>
                        }
                        <td style="text-align:center">
                            <button type="button" class="pp-btn-delete" title="Delete row"
                                    @onclick="() => DeleteRowAsync(row.MeasurementPoint)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<dialog @ref="_addColDialog" class="pp-create-dialog" @oncancel="CloseAddColAsync">
    <h3 style="font-family:var(--font-display);margin-bottom:12px">Add size column</h3>
    <div class="form-row">
        <label>Size label (e.g. 40 or 3XL)</label>
        <input class="status-select" style="width:100%" @bind="_newColLabel" maxlength="8" />
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
        <button type="button" class="btn btn-outline" @onclick="CloseAddColAsync">Cancel</button>
        <button type="button" class="btn btn-gold" @onclick="AddColumnAsync" disabled="@_busy">Add</button>
    </div>
</dialog>

<dialog @ref="_addRowDialog" class="pp-create-dialog" @oncancel="CloseAddRowAsync">
    <h3 style="font-family:var(--font-display);margin-bottom:12px">Add measurement row</h3>
    <div class="form-row">
        <label>Measurement point (e.g. BO or Waist)</label>
        <input class="status-select" style="width:100%" @bind="_newRowLabel" maxlength="64" />
    </div>
    <div class="form-row">
        <label>Copy values from (optional)</label>
        <select class="status-select" style="width:100%" @bind="_copyFromRow">
            <option value="">— blank —</option>
            @foreach (var row in _rows)
            {
                <option value="@row.MeasurementPoint">@row.MeasurementPoint</option>
            }
        </select>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
        <button type="button" class="btn btn-outline" @onclick="CloseAddRowAsync">Cancel</button>
        <button type="button" class="btn btn-gold" @onclick="AddRowAsync" disabled="@_busy">Add</button>
    </div>
</dialog>

@code {
    [Parameter] public int PatternId { get; set; }

    private List<CoreModel.Pattern> _patterns = [];
    private CoreModel.SizeChartSnapshot _snapshot = new();
    private int _selectedPatternId;
    private string _chartMode = CoreModel.MeasurementChartMode.Body;
    private bool _useCustomChart;
    private List<string> _columns = [];
    private List<CoreModel.SizeRow> _rows = [];
    private ElementReference _addColDialog;
    private ElementReference _addRowDialog;
    private string? _message;
    private string? _success;
    private bool _busy;
    private string _newColLabel = "";
    private string _newRowLabel = "";
    private string _copyFromRow = "";
    private string _scopeSearch = "";

    protected override void OnParametersSet()
    {
        if (PatternId > 0)
            _selectedPatternId = PatternId;
    }

    protected override void OnInitialized()
    {
        _patterns = PatternService.GetAll().OrderBy(p => p.Code).ToList();
        LoadTable();
    }

    private int? ScopeId => _selectedPatternId > 0 ? _selectedPatternId : null;

    private IEnumerable<CoreModel.Pattern> FilteredPatterns
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_scopeSearch))
                return _patterns;
            var s = _scopeSearch.Trim();
            return _patterns.Where(p =>
                p.Code.Contains(s, StringComparison.OrdinalIgnoreCase)
                || p.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                || p.Season.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void OnScopeSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var matches = FilteredPatterns.ToList();
        if (matches.Count == 0) return;
        var term = _scopeSearch.Trim();
        var exact = matches.FirstOrDefault(p =>
            p.Code.Equals(term, StringComparison.OrdinalIgnoreCase));
        _selectedPatternId = (exact ?? matches[0]).Id;
        OnPatternChanged();
    }

    private void LoadTable()
    {
        _message = null;
        _snapshot = SizeChartService.GetSnapshot(ScopeId);
        _chartMode = _snapshot.ChartMode;
        _useCustomChart = _snapshot.UseCustomChart;
        _columns = _snapshot.Columns.ToList();
        _rows = _snapshot.Rows.Select(CloneRow).ToList();
    }

    private static CoreModel.SizeRow CloneRow(CoreModel.SizeRow r) => new()
    {
        MeasurementPoint = r.MeasurementPoint,
        ToleranceCm = r.ToleranceCm,
        MeasurementMethod = r.MeasurementMethod,
        Values = r.Values.ToList(),
    };

    private bool IsBaseColumn(string col, int index)
    {
        if (_selectedPatternId > 0)
        {
            var pattern = _patterns.FirstOrDefault(p => p.Id == _selectedPatternId);
            if (pattern is not null && !string.IsNullOrWhiteSpace(pattern.BaseSize))
                return col.Equals(pattern.BaseSize, StringComparison.OrdinalIgnoreCase);
        }
        return col.Equals("M", StringComparison.OrdinalIgnoreCase) || index == 2;
    }

    private void OnPatternChanged()
    {
        _success = null;
        if (_selectedPatternId > 0)
            Navigation.NavigateTo($"module/size-chart/{_selectedPatternId}", replace: true);
        else
            Navigation.NavigateTo("module/size-chart", replace: true);
        LoadTable();
    }

    private void SetChartMode(string mode)
    {
        if (_selectedPatternId <= 0) return;
        var (ok, error) = SizeChartService.SetChartSettings(_selectedPatternId, _useCustomChart, mode);
        if (!ok) { _message = error; return; }
        _chartMode = mode;
        _success = $"Chart mode set to {mode}.";
        LoadTable();
    }

    private void OnCustomChartChanged()
    {
        if (_selectedPatternId <= 0) return;
        var (ok, error) = SizeChartService.SetChartSettings(_selectedPatternId, _useCustomChart, _chartMode);
        if (!ok) { _message = error; _useCustomChart = !_useCustomChart; return; }
        _success = _useCustomChart ? "Using custom chart for this style." : "Using global chart values.";
        LoadTable();
    }

    private void OnCellChanged(string measurementPoint, int columnIndex, ChangeEventArgs e)
    {
        if (!TryParseDecimal(e, out var value)) { _message = "Invalid number."; return; }
        var (ok, error) = SizeChartService.TryUpdateCell(measurementPoint, columnIndex, value, ScopeId);
        if (!ok) { _message = error; LoadTable(); return; }
        var row = _rows.FirstOrDefault(r => r.MeasurementPoint == measurementPoint);
        if (row is not null && columnIndex < row.Values.Count)
            row.Values[columnIndex] = value;
        _message = null;
    }

    private void OnToleranceChanged(string measurementPoint, ChangeEventArgs e)
    {
        if (!TryParseDecimal(e, out var value)) { _message = "Invalid tolerance."; return; }
        var row = _rows.FirstOrDefault(r => r.MeasurementPoint == measurementPoint);
        var (ok, error) = SizeChartService.TryUpdateRowMeta(measurementPoint, value, row?.MeasurementMethod, ScopeId);
        if (!ok) { _message = error; return; }
        if (row is not null) row.ToleranceCm = value;
    }

    private void OnMethodChanged(string measurementPoint, ChangeEventArgs e)
    {
        var row = _rows.FirstOrDefault(r => r.MeasurementPoint == measurementPoint);
        var method = e.Value?.ToString() ?? "";
        var (ok, error) = SizeChartService.TryUpdateRowMeta(measurementPoint, row?.ToleranceCm ?? 0m, method, ScopeId);
        if (!ok) { _message = error; return; }
        if (row is not null) row.MeasurementMethod = method;
    }

    private static bool TryParseDecimal(ChangeEventArgs e, out decimal value) =>
        decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out value)
        || decimal.TryParse(e.Value?.ToString(), out value);

    private async Task OpenAddColAsync()
    {
        _newColLabel = "";
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("patternPro.openDialog", _addColDialog);
    }

    private async Task CloseAddColAsync()
        => await JS.InvokeVoidAsync("patternPro.closeDialog", _addColDialog);

    private async Task OpenAddRowAsync()
    {
        _newRowLabel = "";
        _copyFromRow = "";
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("patternPro.openDialog", _addRowDialog);
    }

    private async Task CloseAddRowAsync()
        => await JS.InvokeVoidAsync("patternPro.closeDialog", _addRowDialog);

    private async Task AddColumnAsync()
    {
        _busy = true;
        _message = null;
        _success = null;
        try
        {
            var (ok, error) = SizeChartService.TryAddSizeColumn(_newColLabel, ScopeId);
            if (!ok) { _message = error; return; }
            _success = $"Added size '{_newColLabel.Trim()}'.";
            _newColLabel = "";
            LoadTable();
            await CloseAddColAsync();
        }
        finally { _busy = false; }
    }

    private async Task AddRowAsync()
    {
        _busy = true;
        _message = null;
        _success = null;
        try
        {
            var (ok, error) = SizeChartService.TryAddMeasurementRow(
                _newRowLabel.Trim(),
                string.IsNullOrWhiteSpace(_copyFromRow) ? null : _copyFromRow,
                ScopeId);
            if (!ok) { _message = error; return; }
            _success = $"Added '{_newRowLabel.Trim()}'.";
            _newRowLabel = "";
            _copyFromRow = "";
            LoadTable();
            await CloseAddRowAsync();
        }
        finally { _busy = false; }
    }

    private Task CopyGlobalAsync()
    {
        if (_selectedPatternId <= 0) return Task.CompletedTask;
        _busy = true;
        _message = null;
        _success = null;
        try
        {
            var (ok, error) = SizeChartService.CopyGlobalToPattern(_selectedPatternId);
            if (!ok) { _message = error; return Task.CompletedTask; }
            _useCustomChart = true;
            _success = "Copied global chart to this style.";
            LoadTable();
        }
        finally { _busy = false; }
        return Task.CompletedTask;
    }

    private Task LoadGarmentTemplateAsync()
    {
        if (_selectedPatternId <= 0) return Task.CompletedTask;
        _busy = true;
        _message = null;
        _success = null;
        try
        {
            var (ok, error) = SizeChartService.InitializeGarmentTemplate(_selectedPatternId);
            if (!ok) { _message = error; return Task.CompletedTask; }
            _useCustomChart = true;
            _chartMode = CoreModel.MeasurementChartMode.Garment;
            _success = "Garment template loaded (BO, C1, sizes 36–54).";
            LoadTable();
        }
        finally { _busy = false; }
        return Task.CompletedTask;
    }

    private async Task DeleteRowAsync(string measurementPoint)
    {
        if (!await DesktopConfirm.DeleteAsync(JS, $"measurement row \"{measurementPoint}\""))
            return;
        var (ok, error) = SizeChartService.TryDeleteMeasurementRow(measurementPoint, ScopeId);
        if (!ok) { _message = error; return; }
        _success = $"Deleted row '{measurementPoint}'.";
        LoadTable();
    }

    private async Task DeleteColumnAsync(int columnIndex, string label)
    {
        if (!await DesktopConfirm.DeleteAsync(JS, $"size column \"{label}\""))
            return;
        var (ok, error) = SizeChartService.TryDeleteSizeColumn(columnIndex, ScopeId);
        if (!ok) { _message = error; return; }
        _success = $"Deleted size '{label}'.";
        LoadTable();
    }

    private async Task ExportCsv()
    {
        _busy = true;
        _message = null;
        try
        {
            var csv = SizeChartService.ExportCsv(ScopeId);
            var name = _selectedPatternId > 0 ? $"size-chart-{_selectedPatternId}.csv" : "size-chart.csv";
            var path = await DesktopFileSave.SaveToDownloadsAsync(
                System.Text.Encoding.UTF8.GetBytes(csv),
                name);
            _success = $"CSV saved to Downloads: {path}";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally { _busy = false; }
    }
}
