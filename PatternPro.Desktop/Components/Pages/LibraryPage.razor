@page "/module/library"
@attribute [Authorize]
@implements IDisposable
@using Pattern.Web.Model
@using PatternPro.Desktop.Helpers
@using PatternPro.Desktop.Services
@inject IPatternService PatternService
@inject IPieceService PieceService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DesktopToastService Toast

<div class="lib-page">
    <header class="lib-header">
        <div class="lib-header__main">
            <h1 class="page-title">Pattern Library</h1>
            <p class="page-sub">Patterns with saved canvas data — open any to continue editing.</p>
        </div>
        <div class="lib-header__actions">
            @if (_loading)
            {
                <span class="lib-stats lib-stats--pending">Updating…</span>
            }
            else
            {
                <span class="lib-stats">
                    <strong>@_saved.Count</strong> saved · <strong>@_unsaved.Count</strong> not in canvas
                </span>
            }
            <NavLink class="btn btn-gold btn-sm" href="@CanvasModuleHref">+ New canvas</NavLink>
            <NavLink class="btn btn-outline btn-sm" href="">Dashboard</NavLink>
        </div>
    </header>

    @if (_loading)
    {
        <div class="lib-panel lib-panel--center lib-panel--loading" role="status" aria-live="polite">
            <div class="lib-empty-title">Loading library…</div>
            <div class="lib-empty-sub">Reading saved canvas patterns from the database.</div>
        </div>
    }
    else if (_saved.Count > 0)
    {
        <div class="lib-section-title">
            <span class="lib-section-dot lib-dot-saved"></span>
            Saved canvas patterns
        </div>
        <div class="lib-grid">
            @foreach (var e in _saved)
            {
                <div class="lib-card lib-card--saved">
                    <div class="lib-card-top">
                        <div class="lib-card-code">@e.Code</div>
                        <span class="lib-status-dot lib-dot-saved" title="Canvas data saved"></span>
                    </div>
                    <div class="lib-card-name">@e.Name</div>
                    <div class="lib-card-meta">
                        <span class="lib-meta-tag">@e.Style</span>
                        <span class="lib-meta-tag">@e.BaseSize</span>
                        <span class="lib-meta-tag">@e.Category</span>
                    </div>
                    <div class="lib-card-pieces">@e.PieceCount piece@(e.PieceCount == 1 ? "" : "s") saved</div>
                    <div class="lib-card-footer">
                        <span class="lib-date">@e.Date</span>
                        <div class="lib-card-actions">
                            <NavLink class="btn btn-gold btn-sm" href="@CanvasHref(e)">Open canvas</NavLink>
                            <button type="button" class="pp-btn-delete" @onclick="() => DeletePatternAsync(e)">Delete</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="lib-panel lib-panel--center">
            <div class="lib-empty-title">No canvas data saved yet</div>
            <div class="lib-empty-sub">Open a pattern in Canvas and click <strong>Save all</strong> — it will appear here.</div>
            <NavLink class="btn btn-gold btn-sm lib-panel-cta" href="@CanvasModuleHref">Open canvas</NavLink>
        </div>
    }

    @if (!_loading && _unsaved.Count > 0)
    {
        <div class="lib-section-title" style="margin-top:28px">
            <span class="lib-section-dot lib-dot-unsaved"></span>
            Not yet in canvas
        </div>
        <div class="lib-grid lib-grid--muted">
            @foreach (var e in _unsaved)
            {
                <div class="lib-card lib-card--unsaved">
                    <div class="lib-card-top">
                        <div class="lib-card-code">@e.Code</div>
                    </div>
                    <div class="lib-card-name">@e.Name</div>
                    <div class="lib-card-meta">
                        <span class="lib-meta-tag">@e.Style</span>
                        <span class="lib-meta-tag">@e.BaseSize</span>
                    </div>
                    <div class="lib-card-footer">
                        <span class="lib-date">@e.Date</span>
                        <div class="lib-card-actions">
                            <NavLink class="btn btn-outline btn-sm" href="@CanvasHref(e)">Start in canvas</NavLink>
                            <button type="button" class="pp-btn-delete" @onclick="() => DeletePatternAsync(e)">Delete</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<LibraryEntryViewModel> _saved = [];
    private List<LibraryEntryViewModel> _unsaved = [];
    private bool _loading = true;
    private bool _loadInProgress;

    private string _styleKey = "skinny";
    private string CanvasModuleHref =>
        DesktopShellNavigation.HrefWithStyle("module/canvas", _styleKey);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        RefreshStyleFromUri();
        _ = LoadEntriesAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RefreshStyleFromUri();
        var path = Navigation.ToBaseRelativePath(e.Location).Split('?', '#')[0];
        if (path.StartsWith("module/library", StringComparison.OrdinalIgnoreCase))
            _ = LoadEntriesAsync();
    }

    private void RefreshStyleFromUri() =>
        _styleKey = DesktopShellNavigation.StyleFromUri(Navigation);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task LoadEntriesAsync()
    {
        if (_loadInProgress) return;
        _loadInProgress = true;
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var entries = await Task.Run(() =>
            {
                var savedCounts = PieceService.GetSavedPatternPieceCounts();
                return PatternService.GetAll().Select(p =>
                {
                    var styleKey = FitStyleKeys.Normalize(p.Style);
                    var hasSaved = savedCounts.ContainsKey(p.Id);
                    var pieceCount = hasSaved && savedCounts.TryGetValue(p.Id, out var n) ? n : 0;

                    return new LibraryEntryViewModel
                    {
                        Id = p.Id,
                        Code = p.Code,
                        Name = p.Name,
                        Style = p.Style,
                        StyleKey = styleKey,
                        BaseSize = p.BaseSize,
                        Category = p.Category,
                        Status = p.Status,
                        Date = p.Date,
                        HasCanvas = hasSaved,
                        PieceCount = pieceCount,
                    };
                }).ToList();
            });

            _saved = entries.Where(e => e.HasCanvas).ToList();
            _unsaved = entries.Where(e => !e.HasCanvas).ToList();
        }
        finally
        {
            _loading = false;
            _loadInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string CanvasHref(LibraryEntryViewModel e) =>
        $"module/canvas?patternId={e.Id}&style={Uri.EscapeDataString(e.StyleKey)}";

    private async Task DeletePatternAsync(LibraryEntryViewModel e)
    {
        if (!await DesktopConfirm.DeleteAsync(JS, $"pattern {e.Code} ({e.Name})"))
            return;
        if (!PatternService.Delete(e.Id))
        {
            Toast.Show("Delete failed", "Could not delete pattern.", DesktopToastType.Error, "⚠");
            return;
        }
        Toast.Show("Pattern deleted", $"{e.Code} removed.", DesktopToastType.Success, "🗑");
        await LoadEntriesAsync();
    }
}
