@page "/module/canvas"
@attribute [Authorize]
@using CoreModel = Pattern.Core.Model
@using PatternPro.Desktop.Canvas
@using PatternPro.Desktop.Components.Canvas
@using PatternPro.Desktop.Helpers
@using PatternPro.Desktop.Services
@using Microsoft.Maui.Storage
@inject IPieceService PieceService
@inject IPatternService PatternService
@inject IPatternDraftingService DraftingService
@inject DesktopCanvasHost CanvasHost
@inject NavigationManager Navigation

<div class="cv-editor-page" tabindex="0" @onkeydown="OnKeyDown" @ref="_pageRoot">
    <nav class="fit-tabs cv-fit-tabs">
        @foreach (var opt in StyleOptions)
        {
            <button type="button"
                    class="fit-tab @(_styleKey == opt.Key ? "active" : "")"
                    @onclick="() => SelectStyle(opt.Key)">
                @opt.Label
            </button>
        }
        <span style="flex:1"></span>
        <select class="status-select" style="max-width:200px" @bind="_patternId" @bind:after="LoadPieces"
                @onkeydown:stopPropagation="true">
            <option value="0">— Style template —</option>
            @foreach (var p in _patterns)
            {
                <option value="@p.Id">@p.Code @p.Name</option>
            }
        </select>
    </nav>

    <div class="cv-header">
        <div class="cv-header-brand">
            <span class="cv-title">Canvas</span>
            <span class="cv-piece-badge">@PieceBadge</span>
        </div>
        @if (_dirty)
        {
            <span class="cv-save-indicator">Unsaved</span>
        }
        <div class="cv-sep"></div>
        <div class="cv-header-actions">
            <button type="button" class="btn btn-outline btn-sm" @onclick="UndoAsync" disabled="@(!CanvasHost.CanUndo)">↺ Undo</button>
            <button type="button" class="btn btn-outline btn-sm" @onclick="ClearCanvasAsync" disabled="@(_pieces.Count == 0 && CanvasHost.DrawPointCount == 0)">✕ Clear</button>
            <div class="cv-sep"></div>
            <button type="button" class="btn btn-outline btn-sm" @onclick="FitAll">⊞ Fit All</button>
            <button type="button" class="btn btn-outline btn-sm" @onclick="SaveAll" disabled="@(_saving || !_dirty || _pieces.Count == 0)">
                @(_saving ? "Saving…" : "⬆ Save All")
            </button>
            <div class="cv-sep"></div>
            <NavLink class="btn btn-outline btn-sm" href="@NestHref">Nest ↗</NavLink>
            <NavLink class="btn btn-gold btn-sm" href="@ExportHref">↓ Export DXF</NavLink>
        </div>
    </div>

    @if (_loading)
    {
        <div class="cv-loading">Loading pieces…</div>
    }
    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="alert-error" style="margin:0">@_status</div>
    }
    @if (!string.IsNullOrEmpty(_saveMsg))
    {
        <div class="cv-save-msg @(_saveOk ? "ok" : "err")" style="margin:0">@_saveMsg</div>
    }

    <div class="canvas-shell">
        <aside class="canvas-pieces-list">
            <div class="cpl-header">
                <span>Pieces</span>
                <span class="cpl-count-badge">@_pieces.Count</span>
                @if (_pieces.Count > 0)
                {
                    <button type="button" class="cpl-select-all" @onclick="SelectAllPieces">All</button>
                }
            </div>
            @if (_pieces.Count == 0)
            {
                <div class="cpl-empty-msg">
                    <div class="cpl-empty-icon">◻</div>
                    <div class="cpl-empty-txt">No pieces yet.<br />Use ✏ Draw or ⚡ Generate to start.</div>
                </div>
            }
            else
            {
                @for (var i = 0; i < _pieces.Count; i++)
                {
                    var idx = i;
                    var p = _pieces[idx];
                    <div class="cpl-item @(_selectedIndices.Contains(idx) ? "active" : "")"
                         @onclick="e => SelectPiece(idx, e.CtrlKey)">
                        <span class="cpl-num">@(idx + 1)</span>
                        <div class="cpl-dot" style="background:@p.Color"></div>
                        <div>
                            <div class="cpl-name">@p.Name</div>
                            <div class="cpl-cut">@p.Cut</div>
                        </div>
                    </div>
                }
            }
        </aside>

        <div class="canvas-main">
            <div class="canvas-toolbar">
                <div class="ctb-group">
                    <span class="ctb-group-label">Navigate</span>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Select ? "active" : "")"
                            title="Select and move (S)" @onclick="() => SetTool(CanvasToolMode.Select)">↖ Select</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Pan ? "active" : "")"
                            title="Pan (P)" @onclick="() => SetTool(CanvasToolMode.Pan)">✥ Pan</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Measure ? "active" : "")"
                            title="Measure distance (M)" @onclick="() => SetTool(CanvasToolMode.Measure)">📏 Measure</button>
                </div>
                <div class="ctb-sep"></div>
                <div class="ctb-group">
                    <span class="ctb-group-label">Draw</span>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Draw ? "active" : "")"
                            title="Draw polygon (D)" @onclick="() => SetTool(CanvasToolMode.Draw)">✏ Draw</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Point ? "active" : "")"
                            title="Add point on edge (A)" @onclick="() => SetTool(CanvasToolMode.Point)">● Point</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.DeletePoint ? "active" : "")"
                            title="Delete point (X)" @onclick="() => SetTool(CanvasToolMode.DeletePoint)">✕ Del Pt</button>
                </div>
                <div class="ctb-sep"></div>
                <div class="ctb-group">
                    <span class="ctb-group-label">Curves</span>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Curve ? "active" : "")"
                            title="Curve edge / drag handle (C)" @onclick="() => SetTool(CanvasToolMode.Curve)">⌇ Curve</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Arc ? "active" : "")"
                            title="Arc edge — click edge and drag (K)" @onclick="() => SetTool(CanvasToolMode.Arc)">◠ Arc</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Smooth ? "active" : "")"
                            title="Smooth corner (U)" @onclick="() => SetTool(CanvasToolMode.Smooth)">∿ Smooth</button>
                    <button type="button" class="ctb-btn" title="Straighten edge under cursor"
                            @onclick="StraightenEdge">— Line</button>
                </div>
                <div class="ctb-sep"></div>
                <div class="ctb-group">
                    <span class="ctb-group-label">Transform</span>
                    <button type="button" class="ctb-btn" title="Mirror horizontal (H)" @onclick="MirrorHorizontalAsync">⇋ Mirror H</button>
                    <button type="button" class="ctb-btn" title="Mirror vertical (V)" @onclick="MirrorVerticalAsync">⇅ Mirror V</button>
                    <button type="button" class="ctb-btn" title="Rotate 90° (R)" @onclick="Rotate90Async">↻ Rot 90°</button>
                    <button type="button" class="ctb-btn" title="Duplicate selected piece" @onclick="DuplicateSelectedAsync">⧉ Duplicate</button>
                </div>
                <div class="ctb-sep"></div>
                <div class="ctb-group">
                    <span class="ctb-group-label">Marks</span>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.Notch ? "active" : "")"
                            title="Notch (N)" @onclick="() => SetTool(CanvasToolMode.Notch)">◆ Notch</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.InternalLine ? "active" : "")"
                            title="Internal construction line (I)" @onclick="() => SetTool(CanvasToolMode.InternalLine)">┄ Guide</button>
                    <button type="button" class="ctb-btn @(CanvasHost.ToolMode == CanvasToolMode.WalkSeam ? "active" : "")"
                            title="Walk seam — compare two edge lengths (W)" @onclick="() => SetTool(CanvasToolMode.WalkSeam)">⇄ Walk</button>
                </div>
                <div class="ctb-sep"></div>
                <button type="button" class="ctb-btn @(CanvasHost.EditorOptions.SnapEnabled ? "active" : "")"
                        title="Snap to grid, points, edges (G)" @onclick="ToggleSnap">⊞ Snap</button>
                <button type="button" class="ctb-btn @(CanvasHost.EditorOptions.SymmetryEnabled ? "active" : "")"
                        title="Half-pattern symmetry — edits mirror live (Y)" @onclick="ToggleSymmetry">⇔ Symmetry</button>
                <button type="button" class="ctb-btn" title="Import DXF from Optitex or other CAD"
                        @onclick="ImportDxfAsync">↓ Import DXF</button>
                <div class="ctb-sep"></div>
                <button type="button" class="ctb-btn @(CanvasHost.Layers.ShowSeamAllowance ? "active" : "")"
                        @onclick='() => ToggleLayer("sa")'>⬜ SA</button>
                <button type="button" class="ctb-btn @(CanvasHost.Layers.ShowGrain ? "active" : "")"
                        @onclick='() => ToggleLayer("grain")'>⇅ Grain</button>
                <button type="button" class="ctb-btn @(CanvasHost.Layers.ShowLabels ? "active" : "")"
                        @onclick='() => ToggleLayer("labels")'>T Labels</button>
                <button type="button" class="ctb-btn @(CanvasHost.Layers.ShowInternalLines ? "active" : "")"
                        @onclick='() => ToggleLayer("guides")'>┄ Guides</button>
                <div class="ctb-sep"></div>
                <button type="button" class="ctb-btn" @onclick="() => CanvasHost.ZoomOut()">−</button>
                <span class="ctb-label">@($"{Math.Round(CanvasHost.ZoomPercent)}%")</span>
                <button type="button" class="ctb-btn" @onclick="() => CanvasHost.ZoomIn()">+</button>
            </div>

            <div class="canvas-draw">
                <div class="canvas-grid-bg"></div>
                @if (_pieces.Count == 0 && !_loading)
                {
                    <div class="cv-empty-state">
                        <div class="cv-empty-icon">✏</div>
                        <div class="cv-empty-title">Empty Canvas</div>
                        <div class="cv-empty-sub">Select a pattern or style template, then use ⚡ Generate in the panel to auto-draft from size chart.</div>
                    </div>
                }
                <NativeCanvasSlot @ref="_slot"
                                    Mode="CanvasSurfaceMode.Pattern"
                                    CssClass="native-canvas-slot cv-native-slot" />
            </div>
        </div>

        <aside class="canvas-props">
            <div class="cp-section">
                <div class="cp-label">Edit all pieces (@_selectedIndices.Count selected)</div>
                <div style="font-size:10.5px;color:var(--ink4);margin-bottom:8px;line-height:1.55">
                    Click <b>All</b> in the piece list (or Ctrl+A), then move, mirror, or rotate every selected piece together.
                    Hold <b>Ctrl</b> and click pieces to add/remove from selection.
                </div>
                <div class="sa-stack">
                    <div>
                        <label class="sa-field-label">Seam allowance all (cm)</label>
                        <input type="number" class="cp-input sa-input-lg" step="0.1" min="0"
                               @bind="_bulkSaCm" @onkeydown:stopPropagation="true" />
                    </div>
                    <button type="button" class="btn btn-gold btn-sm" style="width:100%" @onclick="ApplySeamAllowanceToAll">
                        Apply SA to all pieces
                    </button>
                </div>
            </div>

            <div class="cp-section">
                <div class="cp-label">Selection</div>
                <div class="cp-row"><span class="cp-key">Piece</span><span class="cp-val">@SelectionName</span></div>
                <div class="cp-row"><span class="cp-key">Points</span><span class="cp-val">@SelectionPoints</span></div>
                <div class="cp-row"><span class="cp-key">Width</span><span class="cp-val">@SelectionWidth</span></div>
                <div class="cp-row"><span class="cp-key">Height</span><span class="cp-val">@SelectionHeight</span></div>
                <div class="cp-row"><span class="cp-key">Perimeter</span><span class="cp-val">@SelectionPerimeter</span></div>
                <div class="cp-row"><span class="cp-key">Cursor</span><span class="cp-val">@CanvasHost.CursorPositionDisplay</span></div>
                <div class="cp-row"><span class="cp-key">Snap</span><span class="cp-val">@CanvasHost.SnapKindDisplay</span></div>
                <div class="cp-row"><span class="cp-key">Vertex</span><span class="cp-val">@CanvasHost.SelectedVertexDisplay</span></div>
            </div>

            @{
                var live = CanvasHost.GetLiveMeasurements();
            }
            @if (live is not null && _selectedIndex is not null)
            {
                <div class="cp-section">
                    <div class="cp-label">Live measurements</div>
                    @if (live.IsLegPiece)
                    {
                        <div class="cp-row"><span class="cp-key">Waist arc</span><span class="cp-val">@FormatMeasure(live.WaistArcPx)</span></div>
                        <div class="cp-row"><span class="cp-key">Inseam</span><span class="cp-val">@FormatMeasure(live.InseamPx)</span></div>
                        <div class="cp-row"><span class="cp-key">Rise</span><span class="cp-val">@FormatMeasure(live.RisePx)</span></div>
                    }
                    else if (CanvasHost.SelectedEdgeIndex is null)
                    {
                        <div style="font-size:10.5px;color:var(--ink4);line-height:1.55">
                            Waist / inseam apply to <b>leg</b> pieces only. Click an edge in Select mode to measure this piece.
                        </div>
                    }
                    @if (CanvasHost.SelectedEdgeIndex is int edgeIdx)
                    {
                        <div class="cp-row"><span class="cp-key">Edge @(edgeIdx + 1)</span><span class="cp-val">@FormatMeasure(live.SelectedEdgePx)</span></div>
                    }
                    @if (live.IsLegPiece)
                    {
                        <div style="font-size:10.5px;color:var(--ink4);line-height:1.55;margin-top:6px">
                            Labels appear on the canvas. Click an edge in Select mode to inspect it.
                        </div>
                    }
                </div>
            }

            @if (CanvasHost.SelectedVertexIndex is not null && _selectedIndex is int vPieceIdx && vPieceIdx >= 0 && vPieceIdx < _pieces.Count)
            {
                <div class="cp-section">
                    <div class="cp-label">Point edit</div>
                    <div class="form-row-2" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
                        <div>
                            <label class="sa-field-label">X (cm)</label>
                            <input type="number" class="cp-input" step="0.1" @bind="_vertexXCm" @onkeydown:stopPropagation="true" />
                        </div>
                        <div>
                            <label class="sa-field-label">Y (cm)</label>
                            <input type="number" class="cp-input" step="0.1" @bind="_vertexYCm" @onkeydown:stopPropagation="true" />
                        </div>
                    </div>
                    <button type="button" class="btn btn-gold btn-sm" style="width:100%;margin-bottom:8px" @onclick="ApplyVertexPositionAsync">Set position</button>
                    <div class="form-row-2" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
                        <div>
                            <label class="sa-field-label">ΔX (cm)</label>
                            <input type="number" class="cp-input" step="0.1" @bind="_vertexDxCm" @onkeydown:stopPropagation="true" />
                        </div>
                        <div>
                            <label class="sa-field-label">ΔY (cm)</label>
                            <input type="number" class="cp-input" step="0.1" @bind="_vertexDyCm" @onkeydown:stopPropagation="true" />
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline btn-sm" style="width:100%" @onclick="MoveVertexByDeltaAsync">Move by delta</button>
                </div>
            }

            @if (CanvasHost.SelectedEdgeIndex is not null)
            {
                <div class="cp-section">
                    <div class="cp-label">Edge seam allowance</div>
                    <div style="font-size:10.5px;color:var(--ink4);margin-bottom:8px;line-height:1.55">
                        Edge @(CanvasHost.SelectedEdgeIndex!.Value + 1) — overrides the piece default for this edge only.
                    </div>
                    <label class="sa-field-label">SA (cm)</label>
                    <input type="number" class="cp-input sa-input-lg" step="0.1" min="0"
                           value="@CanvasHost.EdgeSeamAllowanceCmDisplay()"
                           @onchange="OnEdgeSeamAllowanceChanged"
                           @onkeydown:stopPropagation="true" />
                </div>
            }

            <div class="cp-section">
                <div class="cp-label">Layers</div>
                <div class="tog-row">
                    <span class="tog-lbl">Seam allowance</span>
                    <button type="button" class="tog @(CanvasHost.Layers.ShowSeamAllowance ? "on" : "")"
                            @onclick='() => ToggleLayer("sa")'></button>
                </div>
                <div class="tog-row">
                    <span class="tog-lbl">Grain line</span>
                    <button type="button" class="tog @(CanvasHost.Layers.ShowGrain ? "on" : "")"
                            @onclick='() => ToggleLayer("grain")'></button>
                </div>
                <div class="tog-row">
                    <span class="tog-lbl">Labels</span>
                    <button type="button" class="tog @(CanvasHost.Layers.ShowLabels ? "on" : "")"
                            @onclick='() => ToggleLayer("labels")'></button>
                </div>
                <div class="tog-row">
                    <span class="tog-lbl">Notches</span>
                    <button type="button" class="tog @(CanvasHost.Layers.ShowNotches ? "on" : "")"
                            @onclick='() => ToggleLayer("notches")'></button>
                </div>
                <div class="tog-row">
                    <span class="tog-lbl">Internal guides</span>
                    <button type="button" class="tog @(CanvasHost.Layers.ShowInternalLines ? "on" : "")"
                            @onclick='() => ToggleLayer("guides")'></button>
                </div>
            </div>

            @if (_selectedIndex is int dupIdx && dupIdx >= 0 && dupIdx < _pieces.Count)
            {
                <div class="cp-section">
                    <div class="cp-label">Piece copy</div>
                    <button type="button" class="btn btn-outline btn-sm" style="width:100%;margin-bottom:8px" @onclick="DuplicateSelectedAsync">
                        ⧉ Duplicate piece
                    </button>
                    <label class="sa-field-label">Offset outline (cm)</label>
                    <input type="number" class="cp-input" step="0.1" @bind="_offsetCopyCm" @onkeydown:stopPropagation="true" />
                    <button type="button" class="btn btn-gold btn-sm" style="width:100%;margin-top:8px" @onclick="OffsetSelectedAsync">
                        Offset copy
                    </button>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.55;margin-top:8px">
                        Offset creates a new piece with an expanded/shrunk outline — useful for facings and linings.
                    </div>
                </div>
            }

            @if (_selectedIndex is int selIdx && selIdx >= 0 && selIdx < _pieces.Count)
            {
                var saPiece = _pieces[selIdx];
                <div class="cp-section cp-section--sa">
                    <div class="cp-label">Seam Allowance</div>
                    <div class="sa-stack">
                        <div>
                            <label class="sa-field-label">Distance (cm)</label>
                            <input type="number" class="cp-input sa-input-lg" step="0.1" min="0"
                                   value="@SaCmDisplay(selIdx)"
                                   @onchange="e => OnSeamAllowanceCmChanged(selIdx, e)"
                                   @onkeydown:stopPropagation="true" />
                        </div>
                        <div>
                            <label class="sa-field-label">Corner join</label>
                            <select class="cp-input sa-select-lg" @bind="saPiece.SeamAllowanceJoin" @bind:after="OnPieceMetaChanged"
                                    @onkeydown:stopPropagation="true">
                                <option value="miter">Miter</option>
                                <option value="bevel">Bevel</option>
                                <option value="round">Round</option>
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (CanvasHost.PendingNewPiece is not null)
            {
                <div class="cp-section">
                    <div class="cp-label">New Piece</div>
                    <input type="text" class="cp-input" placeholder="Piece name" @bind="_newPieceName"
                           @onkeydown:stopPropagation="true" />
                    <select class="cp-input" @bind="_newPieceCategory" @onkeydown:stopPropagation="true">
                        <option>Body Panels</option>
                        <option>Closures</option>
                        <option>Pockets</option>
                        <option>Hardware &amp; Details</option>
                    </select>
                    <select class="cp-input" @bind="_newPieceCut" @onkeydown:stopPropagation="true">
                        <option>Cut 2</option>
                        <option>Cut 1</option>
                        <option>Cut 4</option>
                        <option>Cut 8</option>
                    </select>
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                        <label style="font-size:10.5px;color:var(--ink3)">Color</label>
                        <input type="color" @bind="_newPieceColor" style="width:34px;height:22px;border:1px solid var(--bdr);border-radius:4px;cursor:pointer;padding:1px;" />
                    </div>
                    <div style="display:flex;gap:6px">
                        <button type="button" class="btn btn-gold btn-sm" style="flex:1" @onclick="ConfirmNewPieceAsync">✓ Add Piece</button>
                        <button type="button" class="btn btn-outline btn-sm" @onclick="CancelNewPiece">✕</button>
                    </div>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.Draw)
            {
                <div class="cp-section">
                    <div class="cp-label">Draw</div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.6;margin-bottom:8px">
                        @if (CanvasHost.DrawPointCount < 3)
                        {
                            <span>@CanvasHost.DrawPointCount point@(CanvasHost.DrawPointCount == 1 ? "" : "s") placed — need at least 3.</span>
                        }
                        else
                        {
                            <span>@CanvasHost.DrawPointCount points — click the first point or Close shape.</span>
                        }
                    </div>
                    @if (CanvasHost.DrawPointCount >= 3)
                    {
                        <button type="button" class="btn btn-gold btn-sm" style="width:100%;margin-bottom:6px" @onclick="CloseDrawShape">Close shape</button>
                    }
                    <button type="button" class="btn btn-outline btn-sm" style="width:100%" @onclick="CancelDraw">Cancel draw</button>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.Curve)
            {
                <div class="cp-section">
                    <div class="cp-label">Curve Tool</div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.65;margin-bottom:8px">
                        Click an edge to bend it into a cubic Bezier. Drag the blue tangent handles to shape it —
                        two handles per edge, like Optitex curve editing.
                    </div>
                    <button type="button" class="btn btn-outline btn-sm" style="width:100%" @onclick="StraightenEdge">— Straighten edge</button>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.InternalLine)
            {
                <div class="cp-section">
                    <div class="cp-label">Internal guide</div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.65;margin-bottom:8px">
                        Click start, then end to place a dashed construction line (pocket placement, fly line, etc.).
                        Click an existing guide to select it.
                    </div>
                    <label class="sa-field-label">Label preset</label>
                    <select class="cp-input" @bind="CanvasHost.InternalLineLabel" @onkeydown:stopPropagation="true">
                        <option>Guide</option>
                        <option>Pocket</option>
                        <option>Fly</option>
                        <option>Placket</option>
                        <option>Zipper</option>
                    </select>
                    @if (CanvasHost.SelectedInternalLineIndex is int ilIdx && _selectedIndex is int ilPiece && ilPiece >= 0 && ilPiece < _pieces.Count
                         && _pieces[ilPiece].InternalLines is { Count: > 0 } ilines && ilIdx < ilines.Count)
                    {
                        <div class="cp-row" style="margin-top:8px"><span class="cp-key">Selected</span><span class="cp-val">@ilines[ilIdx].Label</span></div>
                        <button type="button" class="btn btn-outline btn-sm" style="width:100%;margin-top:8px" @onclick="DeleteSelectedInternalLineAsync">Delete guide</button>
                    }
                    <button type="button" class="btn btn-outline btn-sm" style="width:100%;margin-top:8px" @onclick="CancelInternalLineDraft">Cancel line</button>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.WalkSeam)
            {
                var walk = CanvasHost.WalkSeamResult;
                <div class="cp-section">
                    <div class="cp-label">Walk seam</div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.65;margin-bottom:8px">
                        Click edge A, then edge B on the selected piece. Compares seam lengths for trousers/denim assembly.
                    </div>
                    @if (walk is not null)
                    {
                        <div class="cp-row"><span class="cp-key">Edge A</span><span class="cp-val">@FormatMeasure(walk.LengthA)</span></div>
                        <div class="cp-row"><span class="cp-key">Edge B</span><span class="cp-val">@FormatMeasure(walk.LengthB)</span></div>
                        <div class="cp-row"><span class="cp-key">Delta</span><span class="cp-val">@FormatMeasure(Math.Abs(walk.DeltaPx)) (@walk.DeltaPercent.ToString("0.#")%)</span></div>
                        <div class="cp-row"><span class="cp-key">Status</span><span class="cp-val">@(walk.Match ? "Match" : "Mismatch")</span></div>
                    }
                    else
                    {
                        <div style="font-size:10.5px;color:var(--ink4)">Pick two edges to compare.</div>
                    }
                    <button type="button" class="btn btn-outline btn-sm" style="width:100%;margin-top:8px" @onclick="ClearWalkSeam">Clear</button>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.Smooth)
            {
                <div class="cp-section">
                    <div class="cp-label">Smooth Tool</div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.65">
                        Click a corner point to smooth the two edges meeting there — like Optitex smooth corners on armholes and crotch curves.
                    </div>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.Arc)
            {
                <div class="cp-section">
                    <div class="cp-label">Arc Tool</div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.65">
                        Click an edge, then drag to bulge it into an arc — good for leg openings and waist curves.
                    </div>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.Measure)
            {
                <div class="cp-section">
                    <div class="cp-label">Measure</div>
                    <div class="cp-row"><span class="cp-key">Distance</span><span class="cp-val">@MeasureDisplay</span></div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.65;margin-top:8px">
                        Click point A, then point B. Third click starts a new measurement.
                    </div>
                    <button type="button" class="btn btn-outline btn-sm" style="width:100%;margin-top:8px" @onclick="ClearMeasure">Clear measure</button>
                </div>
            }
            else if (CanvasHost.ToolMode == CanvasToolMode.DeletePoint)
            {
                <div class="cp-section">
                    <div class="cp-label">Delete Point</div>
                    <div style="font-size:10.5px;color:var(--ink4);line-height:1.65">
                        Click a corner to remove it. Pieces must keep at least 3 points. You can also use Delete/Backspace in Select mode.
                    </div>
                </div>
            }

            <div class="cp-section">
                <div class="cp-label">Auto-Draft Sizes</div>
                <div style="font-size:10.5px;color:var(--ink4);margin-bottom:8px;line-height:1.55">Generate pieces from style block.</div>
                <div class="draft-size-grid">
                    @foreach (var sz in _draftSizes)
                    {
                        <label class="size-cb-label">
                            <input type="checkbox" @bind="sz.Checked" />
                            <span>@sz.Label</span>
                        </label>
                    }
                </div>
                <button type="button" class="btn btn-gold btn-sm" style="width:100%" @onclick="GenerateDraftAsync" disabled="@_generating">
                    @(_generating ? "Generating…" : "⚡ Generate")
                </button>
                @if (!string.IsNullOrEmpty(_draftMsg))
                {
                    <div style="font-size:10.5px;color:var(--ink4);margin-top:8px">@_draftMsg</div>
                }
            </div>

            <div class="cp-section">
                <div class="cp-label">Shortcuts</div>
                <div class="cv-shortcuts">
                    <div><b>S</b> Select &nbsp; <b>P</b> Pan &nbsp; <b>D</b> Draw</div>
                    <div><b>A</b> Point &nbsp; <b>X</b> Del pt &nbsp; <b>N</b> Notch</div>
                    <div><b>C</b> Curve &nbsp; <b>K</b> Arc &nbsp; <b>U</b> Smooth &nbsp; <b>M</b> Measure</div>
                    <div><b>I</b> Guide &nbsp; <b>W</b> Walk seam &nbsp; <b>N</b> Notch</div>
                    <div><b>H</b> Mirror H &nbsp; <b>V</b> Mirror V &nbsp; <b>R</b> Rot 90° &nbsp; <b>G</b> Snap &nbsp; <b>Y</b> Symmetry</div>
                    <div><b>Ctrl+Z</b> Undo &nbsp; <b>Ctrl+S</b> Save</div>
                    <div><b>Space</b> Fit all &nbsp; <b>±</b> Zoom &nbsp; <b>Esc</b> Cancel</div>
                    <div>Right-drag to pan · Drag blue handles to shape curves</div>
                </div>
            </div>
        </aside>
    </div>
</div>

@code {
    private ElementReference _pageRoot;
    private NativeCanvasSlot? _slot;
    private readonly CanvasViewport _viewport = new();
    private List<CoreModel.PieceDefinition> _pieces = [];
    private IReadOnlyList<CoreModel.Pattern> _patterns = [];
    private int _patternId;
    private string _styleKey = "skinny";
    private int? _selectedIndex;
    private HashSet<int> _selectedIndices = [];
    private double _bulkSaCm = 1.0;
    private string? _status;
    private string? _draftMsg;
    private bool _loading;
    private bool _dirty;
    private bool _saving;
    private bool _generating;
    private bool _saveOk;
    private string? _saveMsg;
    private string _newPieceName = "New Piece";
    private string _newPieceCategory = "Body Panels";
    private string _newPieceCut = "Cut 2";
    private string _newPieceColor = "#a78bfa";
    private double _vertexXCm;
    private double _vertexYCm;
    private double _vertexDxCm;
    private double _vertexDyCm;
    private double _offsetCopyCm = 1.0;

    private readonly List<DraftSizeOption> _draftSizes =
    [
        new("XS", false), new("S", false), new("M", true),
        new("L", true), new("XL", true), new("XXL", true),
    ];

    private static readonly (string Key, string Label)[] StyleOptions =
    [
        ("skinny", "Skinny"),
        ("slim", "Slim"),
        ("straight", "Straight"),
        ("bootcut", "Bootcut"),
        ("wideLeg", "Wide Leg"),
    ];

    private string PieceBadge => _pieces.Count == 0 ? "Empty" : $"{_pieces.Count} pieces";
    private string NestHref => $"module/nest?style={Uri.EscapeDataString(_styleKey)}";

    private string SelectedSizesCsv
    {
        get
        {
            var chosen = _draftSizes.Where(s => s.Checked).Select(s => s.Label).ToList();
            return chosen.Count > 0 ? string.Join(",", chosen) : "M";
        }
    }

    private string ExportHref
    {
        get
        {
            var sizes = Uri.EscapeDataString(SelectedSizesCsv);
            var style = Uri.EscapeDataString(_styleKey);
            return _patternId > 0
                ? $"module/export?patternId={_patternId}&style={style}&sizes={sizes}"
                : $"module/export?style={style}&sizes={sizes}";
        }
    }

    private CoreModel.PieceDefinition? _selectedPiece =>
        _selectedIndex is int i && i >= 0 && i < _pieces.Count ? _pieces[i] : null;

    private string SelectionName => _selectedPiece?.Name ?? "—";
    private string SelectionPoints => _selectedPiece?.Points.Count.ToString() ?? "—";
    private string SelectionWidth => FormatMeasure(_selectedPiece is null ? 0 : CanvasPainter.MeasurePiece(_selectedPiece).Width);
    private string SelectionHeight => FormatMeasure(_selectedPiece is null ? 0 : CanvasPainter.MeasurePiece(_selectedPiece).Height);
    private string SelectionPerimeter => FormatMeasure(_selectedPiece is null ? 0 : CanvasPainter.MeasurePiece(_selectedPiece).Perimeter);
    private string MeasureDisplay => CanvasHost.MeasureDistanceDisplay;

    protected override async Task OnInitializedAsync()
    {
        ParseQuery();
        await LoadPiecesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        SyncHost();
        if (_slot is not null)
            await _slot.RefreshBoundsAsync();
        if (firstRender)
        {
            try { await _pageRoot.FocusAsync(); } catch { /* focus optional */ }
            if (_pieces.Count > 0)
                FitAll();
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && (e.Key is "a" or "A"))
        {
            SelectAllPieces();
            return;
        }
        if (e.CtrlKey && (e.Key is "s" or "S"))
        {
            SaveAll();
            return;
        }
        if (e.CtrlKey && (e.Key is "z" or "Z"))
        {
            _ = UndoAsync();
            return;
        }

        switch (e.Key)
        {
            case "s" or "S":
                SetTool(CanvasToolMode.Select);
                break;
            case "p" or "P":
                SetTool(CanvasToolMode.Pan);
                break;
            case "d" or "D":
                SetTool(CanvasToolMode.Draw);
                break;
            case "a" or "A":
                SetTool(CanvasToolMode.Point);
                break;
            case "n" or "N":
                SetTool(CanvasToolMode.Notch);
                break;
            case "c" or "C":
                SetTool(CanvasToolMode.Curve);
                break;
            case "k" or "K":
                SetTool(CanvasToolMode.Arc);
                break;
            case "u" or "U":
                SetTool(CanvasToolMode.Smooth);
                break;
            case "m" or "M":
                SetTool(CanvasToolMode.Measure);
                break;
            case "i" or "I":
                SetTool(CanvasToolMode.InternalLine);
                break;
            case "w" or "W":
                SetTool(CanvasToolMode.WalkSeam);
                break;
            case "g" or "G":
                ToggleSnap();
                break;
            case "y" or "Y":
                ToggleSymmetry();
                break;
            case "h" or "H":
                _ = MirrorHorizontalAsync();
                break;
            case "v" or "V":
                _ = MirrorVerticalAsync();
                break;
            case "r" or "R":
                _ = Rotate90Async();
                break;
            case "x" or "X":
                SetTool(CanvasToolMode.DeletePoint);
                break;
            case "Escape":
                if (CanvasHost.PendingNewPiece is not null)
                    CancelNewPiece();
                else if (CanvasHost.ToolMode == CanvasToolMode.Draw)
                    CancelDraw();
                else if (CanvasHost.ToolMode == CanvasToolMode.Measure)
                    ClearMeasure();
                else if (CanvasHost.ToolMode == CanvasToolMode.InternalLine)
                    CancelInternalLineDraft();
                else if (CanvasHost.ToolMode == CanvasToolMode.WalkSeam)
                    ClearWalkSeam();
                else
                    SetTool(CanvasToolMode.Select);
                break;
            case "Delete":
            case "Backspace":
                if (CanvasHost.ToolMode == CanvasToolMode.InternalLine && CanvasHost.SelectedInternalLineIndex is not null)
                    _ = DeleteSelectedInternalLineAsync();
                else
                    _ = DeleteSelectedVertex();
                break;
            case " ":
                FitAll();
                break;
            case "+" or "=":
                CanvasHost.ZoomIn();
                StateHasChanged();
                break;
            case "-":
                CanvasHost.ZoomOut();
                StateHasChanged();
                break;
        }
    }

    private void SyncHost()
    {
        CanvasHost.ConfigurePattern(_pieces, _viewport, _selectedIndex, _selectedIndices, MarkDirtyAsync, OnSelectedChanged, OnHostChangedAsync);
    }

    private Task OnHostChangedAsync()
    {
        RefreshVertexFieldsFromSelection();
        return InvokeAsync(StateHasChanged);
    }

    private void RefreshVertexFieldsFromSelection()
    {
        if (_selectedIndex is not int si || si < 0 || si >= _pieces.Count
            || CanvasHost.SelectedVertexIndex is not int vi || vi < 0 || vi >= _pieces[si].Points.Count)
            return;

        var pt = _pieces[si].Points[vi];
        _vertexXCm = CanvasUnits.ToCm(pt[0]);
        _vertexYCm = CanvasUnits.ToCm(pt[1]);
    }

    private static string FormatMeasure(float v) => CanvasUnits.FormatCm(v);

    private void ParseQuery()
    {
        var uri = Navigation.Uri;
        var q = uri.IndexOf('?', StringComparison.Ordinal);
        if (q < 0) return;
        foreach (var part in uri[(q + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            if (part.StartsWith("patternId=", StringComparison.Ordinal) &&
                int.TryParse(part["patternId=".Length..], out var id))
                _patternId = id;
            if (part.StartsWith("style=", StringComparison.Ordinal))
                _styleKey = FitStyleKeys.Normalize(Uri.UnescapeDataString(part["style=".Length..]));
        }
    }

    private async Task LoadPiecesAsync()
    {
        _loading = true;
        _status = null;
        _saveMsg = null;
        _draftMsg = null;
        _dirty = false;
        _selectedIndex = null;
        _selectedIndices.Clear();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            _patterns = PatternService.GetAll();
            if (_patternId > 0)
                _pieces = PieceService.GetPieceDefinitions(_patternId, _styleKey).ToList();
            else
                _pieces = PieceService.GetPieceDefinitions(_styleKey).ToList();
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            _pieces = [];
        }
        finally
        {
            _loading = false;
        }

        if (_pieces.Count > 0)
        {
            _selectedIndex = 0;
            _selectedIndices = [0];
        }

        CanvasHost.ClearHistory();
        SyncHost();
    }

    private Task LoadPieces() => LoadPiecesAsync();

    private void SelectStyle(string key)
    {
        _styleKey = key;
        _ = LoadPiecesAsync();
    }

    private void SelectPiece(int index, bool additive = false)
    {
        if (index < 0 || index >= _pieces.Count) return;

        if (additive)
        {
            if (_selectedIndices.Contains(index))
            {
                if (_selectedIndices.Count > 1)
                    _selectedIndices.Remove(index);
            }
            else
                _selectedIndices.Add(index);
        }
        else
            _selectedIndices = [index];

        _selectedIndex = index;
        SyncHost();
        CanvasHost.Invalidate();
        StateHasChanged();
    }

    private void SelectAllPieces()
    {
        if (_pieces.Count == 0)
        {
            _selectedIndex = null;
            _selectedIndices.Clear();
        }
        else
        {
            _selectedIndices = Enumerable.Range(0, _pieces.Count).ToHashSet();
            _selectedIndex = 0;
        }
        SyncHost();
        CanvasHost.Invalidate();
        StateHasChanged();
    }

    private void ApplySeamAllowanceToAll()
    {
        if (_pieces.Count == 0) return;
        var px = CanvasUnits.ToPixels(Math.Max(0, _bulkSaCm));
        foreach (var piece in _pieces)
            piece.SeamAllowance = px;
        MarkDirty();
        CanvasHost.Invalidate();
    }

    private Task OnSelectedChanged(int? index, IReadOnlySet<int> indices)
    {
        _selectedIndex = index;
        _selectedIndices = indices.ToHashSet();
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private Task MarkDirtyAsync()
    {
        MarkDirty();
        return Task.CompletedTask;
    }

    private void MarkDirty()
    {
        _dirty = true;
        _saveMsg = null;
        StateHasChanged();
    }

    private void OnPieceMetaChanged()
    {
        MarkDirty();
        CanvasHost.Invalidate();
    }

    private void SetTool(CanvasToolMode mode)
    {
        CanvasHost.ToolMode = mode;
        if (mode != CanvasToolMode.Draw && CanvasHost.PendingNewPiece is null)
            CanvasHost.CancelDrawSession();
        if (mode != CanvasToolMode.Measure)
            CanvasHost.ClearMeasure();
        if (mode != CanvasToolMode.WalkSeam)
            CanvasHost.ClearWalkSeam();
        if (mode != CanvasToolMode.InternalLine)
            CanvasHost.CancelInternalLineDraft();
        StateHasChanged();
    }

    private void StraightenEdge()
    {
        CanvasHost.StraightenSelectedEdge();
        MarkDirty();
    }

    private void ClearMeasure()
    {
        CanvasHost.ClearMeasure();
        StateHasChanged();
    }

    private void ClearWalkSeam()
    {
        CanvasHost.ClearWalkSeam();
        StateHasChanged();
    }

    private void CancelInternalLineDraft()
    {
        CanvasHost.CancelInternalLineDraft();
        StateHasChanged();
    }

    private async Task DeleteSelectedInternalLineAsync()
    {
        await CanvasHost.DeleteSelectedInternalLineAsync();
        MarkDirty();
    }

    private void ToggleSnap()
    {
        CanvasHost.ToggleSnap();
        StateHasChanged();
    }

    private void ToggleSymmetry()
    {
        CanvasHost.ToggleSymmetry();
        StateHasChanged();
    }

    private async Task ApplyVertexPositionAsync()
    {
        await CanvasHost.ApplyNumericVertexPositionAsync(_vertexXCm, _vertexYCm);
        MarkDirty();
        RefreshVertexFieldsFromSelection();
    }

    private async Task MoveVertexByDeltaAsync()
    {
        await CanvasHost.MoveSelectedVertexByCmAsync(_vertexDxCm, _vertexDyCm);
        MarkDirty();
        RefreshVertexFieldsFromSelection();
    }

    private async Task OnEdgeSeamAllowanceChanged(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var cm)
            && !double.TryParse(e.Value?.ToString(), out cm))
            return;
        await CanvasHost.SetSelectedEdgeSeamAllowanceCmAsync(Math.Max(0, cm));
        MarkDirty();
    }

    private async Task MirrorHorizontalAsync()
    {
        if (_selectedIndices.Count == 0 && _selectedIndex is null) return;
        await CanvasHost.MirrorSelectedHorizontalAsync();
        MarkDirty();
    }

    private async Task MirrorVerticalAsync()
    {
        if (_selectedIndices.Count == 0 && _selectedIndex is null) return;
        await CanvasHost.MirrorSelectedVerticalAsync();
        MarkDirty();
    }

    private async Task Rotate90Async()
    {
        if (_selectedIndices.Count == 0 && _selectedIndex is null) return;
        await CanvasHost.RotateSelected90Async();
        MarkDirty();
    }

    private async Task DuplicateSelectedAsync()
    {
        if (_selectedIndex is not int si || si < 0 || si >= _pieces.Count) return;
        await AddClonedPieceAsync(CanvasPieceCloneHelper.ClonePiece(
            _pieces[si],
            CanvasPieceCloneHelper.NextCopyName(_pieces, _pieces[si].Name)));
    }

    private async Task OffsetSelectedAsync()
    {
        if (_selectedIndex is not int si || si < 0 || si >= _pieces.Count) return;
        await AddClonedPieceAsync(CanvasPieceCloneHelper.OffsetOutlineCopy(
            _pieces[si],
            CanvasPieceCloneHelper.NextCopyName(_pieces, _pieces[si].Name),
            _offsetCopyCm));
    }

    private async Task AddClonedPieceAsync(CoreModel.PieceDefinition copy)
    {
        try
        {
            var (ok, error, piece) = _patternId > 0
                ? PieceService.CreatePatternPiece(
                    _patternId, _styleKey, copy.Name, copy.Category, copy.Cut, copy.Color,
                    copy.Points, copy.OffsetX, copy.OffsetY)
                : PieceService.CreateStylePiece(
                    _styleKey, copy.Name, copy.Category, copy.Cut, copy.Color,
                    copy.Points, copy.OffsetX, copy.OffsetY);

            if (!ok || piece is null)
            {
                _status = error ?? "Could not create copy.";
                return;
            }

            var pts = copy.Points.Select(p => new[] { p[0], p[1] }).ToList();
            if (_patternId > 0)
                PieceService.UpdatePatternPieceGeometry(
                    _patternId, _styleKey, copy.Name,
                    pts, copy.OffsetX, copy.OffsetY,
                    copy.Grain, copy.Cf, copy.Notches,
                    copy.SeamAllowance, copy.SeamAllowanceJoin,
                    copy.Edges, copy.InternalLines);
            else
                PieceService.UpdatePieceGeometry(
                    _styleKey, copy.Name,
                    pts, copy.OffsetX, copy.OffsetY,
                    copy.Grain, copy.Cf, copy.Notches,
                    copy.SeamAllowance, copy.SeamAllowanceJoin,
                    copy.Edges, copy.InternalLines);

            if (_patternId > 0)
                _pieces = PieceService.GetPieceDefinitions(_patternId, _styleKey).ToList();
            else
                _pieces = PieceService.GetPieceDefinitions(_styleKey).ToList();

            _selectedIndex = _pieces.FindIndex(p => p.Name.Equals(copy.Name, StringComparison.OrdinalIgnoreCase));
            if (_selectedIndex < 0) _selectedIndex = _pieces.Count - 1;
            _selectedIndices = _selectedIndex is int ci ? new HashSet<int> { ci } : [];
            _dirty = true;
            _status = null;
            SyncHost();
            CanvasHost.Invalidate();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private string SaCmDisplay(int pieceIndex)
    {
        if (pieceIndex < 0 || pieceIndex >= _pieces.Count) return "0";
        return (CanvasUnits.ToCm(_pieces[pieceIndex].SeamAllowance)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    private void OnSeamAllowanceCmChanged(int pieceIndex, ChangeEventArgs e)
    {
        if (pieceIndex < 0 || pieceIndex >= _pieces.Count) return;
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var cm)
            && !double.TryParse(e.Value?.ToString(), out cm))
            return;
        _pieces[pieceIndex].SeamAllowance = CanvasUnits.ToPixels(Math.Max(0, cm));
        OnPieceMetaChanged();
    }

    private async Task ImportDxfAsync()
    {
        _status = null;
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Import DXF pattern",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.WinUI, [".dxf"] },
                    { DevicePlatform.MacCatalyst, ["dxf"] },
                    { DevicePlatform.iOS, ["com.autodesk.dxf"] },
                    { DevicePlatform.Android, ["application/dxf", "application/octet-stream"] },
                }),
            });

            if (result is null) return;

            await using var stream = await result.OpenReadAsync();
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            var imported = CanvasDxfImporter.Import(text, "Imported");

            if (imported.Count == 0)
            {
                _status = "No closed polylines found in DXF. Use ASCII DXF with closed POLYLINE/LWPOLYLINE (AAMA or PatternPro export). Optitex: export as R12 ASCII, polylines not splines only.";
                return;
            }

            foreach (var piece in imported)
            {
                var (ok, error, created) = _patternId > 0
                    ? PieceService.CreatePatternPiece(
                        _patternId, _styleKey, piece.Name, piece.Category, piece.Cut, piece.Color,
                        piece.Points, piece.OffsetX, piece.OffsetY)
                    : PieceService.CreateStylePiece(
                        _styleKey, piece.Name, piece.Category, piece.Cut, piece.Color,
                        piece.Points, piece.OffsetX, piece.OffsetY);

                if (!ok)
                {
                    _status = error ?? $"Could not import {piece.Name}.";
                    return;
                }
            }

            if (_patternId > 0)
                _pieces = PieceService.GetPieceDefinitions(_patternId, _styleKey).ToList();
            else
                _pieces = PieceService.GetPieceDefinitions(_styleKey).ToList();

            _selectedIndex = _pieces.Count > 0 ? _pieces.Count - imported.Count : null;
            if (_selectedIndex < 0) _selectedIndex = 0;
            _selectedIndices = _selectedIndex is int si ? new HashSet<int> { si } : [];
            _dirty = true;
            _draftMsg = $"Imported {imported.Count} piece(s) from DXF.";
            SyncHost();
            FitAll();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private void CloseDrawShape()
    {
        CanvasHost.CloseDrawShapeFromUi();
        _newPieceName = $"Piece {_pieces.Count + 1}";
    }

    private void CancelDraw()
    {
        CanvasHost.CancelDrawSession();
        SetTool(CanvasToolMode.Select);
    }

    private void CancelNewPiece()
    {
        CanvasHost.CancelPendingPiece();
        SetTool(CanvasToolMode.Select);
    }

    private async Task ConfirmNewPieceAsync()
    {
        var pending = CanvasHost.PendingNewPiece;
        if (pending is null) return;

        var name = _newPieceName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _status = "Enter a piece name.";
            return;
        }

        try
        {
            var (ok, error, piece) = _patternId > 0
                ? PieceService.CreatePatternPiece(
                    _patternId, _styleKey, name, _newPieceCategory, _newPieceCut, _newPieceColor,
                    pending.Points, pending.OffsetX, pending.OffsetY)
                : PieceService.CreateStylePiece(
                    _styleKey, name, _newPieceCategory, _newPieceCut, _newPieceColor,
                    pending.Points, pending.OffsetX, pending.OffsetY);

            if (!ok || piece is null)
            {
                _status = error ?? "Could not create piece.";
                return;
            }

            if (_patternId > 0)
                _pieces = PieceService.GetPieceDefinitions(_patternId, _styleKey).ToList();
            else
                _pieces = PieceService.GetPieceDefinitions(_styleKey).ToList();

            _selectedIndex = _pieces.FindIndex(p => p.Name.Equals(piece.Name, StringComparison.OrdinalIgnoreCase));
            if (_selectedIndex < 0) _selectedIndex = _pieces.Count - 1;
            _selectedIndices = _selectedIndex is int ci ? new HashSet<int> { ci } : [];
            CanvasHost.CancelPendingPiece();
            SetTool(CanvasToolMode.Select);
            _dirty = true;
            _status = null;
            SyncHost();
            FitAll();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private async Task UndoAsync()
    {
        if (!await CanvasHost.UndoAsync()) return;
        _dirty = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearCanvasAsync()
    {
        _pieces.Clear();
        _selectedIndex = null;
        _selectedIndices.Clear();
        _dirty = true;
        _status = null;
        _draftMsg = null;
        CanvasHost.CancelDrawSession();
        CanvasHost.ClearHistory();

        if (_patternId > 0)
            PieceService.ReplacePatternPieces(_patternId, []);
        else
            PieceService.ReplaceStylePieces(_styleKey, []);

        SyncHost();
        CanvasHost.Invalidate();
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteSelectedVertex()
    {
        if (await CanvasHost.TryDeleteVertexAtCursorAsync())
            _dirty = true;
    }

    private void ToggleLayer(string key)
    {
        var layers = CanvasHost.Layers;
        switch (key)
        {
            case "sa": layers.ShowSeamAllowance = !layers.ShowSeamAllowance; break;
            case "grain": layers.ShowGrain = !layers.ShowGrain; break;
            case "labels": layers.ShowLabels = !layers.ShowLabels; break;
            case "notches": layers.ShowNotches = !layers.ShowNotches; break;
            case "guides": layers.ShowInternalLines = !layers.ShowInternalLines; break;
        }
        CanvasHost.Invalidate();
        StateHasChanged();
    }

    private void FitAll()
    {
        var bounds = CanvasPainter.ComputeBounds(_pieces);
        if (!bounds.IsEmpty)
        {
            var w = (float)(CanvasHost.SlotWidth > 1 ? CanvasHost.SlotWidth : 900);
            var h = (float)(CanvasHost.SlotHeight > 1 ? CanvasHost.SlotHeight : 600);
            _viewport.FitToBounds(bounds, w, h);
        }
        SyncHost();
        CanvasHost.Invalidate();
    }

    private void SaveAll()
    {
        _saving = true;
        _saveMsg = null;
        _status = null;
        try
        {
            var (ok, error, saved) = CanvasPieceSaver.SaveAll(PieceService, _patternId, _styleKey, _pieces);
            _saveOk = ok;
            _saveMsg = ok ? $"Saved {saved} piece(s)" : error;
            if (ok) _dirty = false;
        }
        catch (Exception ex)
        {
            _saveOk = false;
            _saveMsg = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task GenerateDraftAsync()
    {
        var sizes = _draftSizes.Where(s => s.Checked).Select(s => s.Label).ToList();
        if (sizes.Count == 0)
        {
            _draftMsg = "Select at least one size.";
            _status = null;
            return;
        }

        _generating = true;
        _draftMsg = "Generating…";
        _status = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            List<CoreModel.PieceDefinition> pieces;
            if (sizes.Count == 1)
            {
                pieces = DraftingService.DraftProductionPieces(_styleKey, sizes[0], _patternId > 0 ? _patternId : null).ToList();
            }
            else
            {
                var graded = DraftingService.DraftGradedSet(_styleKey, sizes, _patternId > 0 ? _patternId : null);
                pieces = graded.Values.SelectMany(v => v).ToList();
            }

            if (_patternId > 0)
            {
                PieceService.ReplacePatternPieces(_patternId, pieces);
                _pieces = PieceService.GetPieceDefinitions(_patternId, _styleKey).ToList();
            }
            else
            {
                PieceService.ReplaceStylePieces(_styleKey, pieces);
                _pieces = PieceService.GetPieceDefinitions(_styleKey).ToList();
            }

            _selectedIndex = _pieces.Count > 0 ? 0 : null;
            _selectedIndices = _pieces.Count > 0 ? new HashSet<int> { 0 } : [];
            _dirty = true;
            _draftMsg = $"Generated {_pieces.Count} pieces ({string.Join(", ", sizes)}).";

            SyncHost();
            if (_slot is not null)
                await _slot.RefreshBoundsAsync();
            FitAll();
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            _draftMsg = null;
        }
        finally
        {
            _generating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private sealed class DraftSizeOption(string label, bool @checked)
    {
        public string Label { get; } = label;
        public bool Checked { get; set; } = @checked;
    }
}
