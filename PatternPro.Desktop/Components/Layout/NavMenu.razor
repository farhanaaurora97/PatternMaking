@implements IDisposable
@using PatternPro.Desktop.Auth
@using PatternPro.Desktop.Helpers
@using PatternPro.Desktop.Services
@inject DesktopAuthService Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject DesktopDataRefreshService DataRefresh
@inject DesktopCanvasHost CanvasHost
@inject DesktopToastService Toast

<div class="sb-brand">
    <div class="sb-logo">
        <div class="sb-logo-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3L4 8v8l8 5 8-5V8l-8-5z" stroke="white" stroke-width="1.6" stroke-linejoin="round" fill="none" opacity=".95"/>
                <path d="M12 3v18M4 8l16 8M20 8L4 16" stroke="white" stroke-width="1.1" stroke-linecap="round" opacity=".45"/>
            </svg>
        </div>
        <div>
            <div class="sb-brand-name">PatternPro</div>
        </div>
    </div>
    <div class="sb-brand-sub">Technical patterns · Bottom wear</div>
</div>

<nav class="sb-nav">
    <div class="sb-section">Module</div>

    <NavLink class="sb-item" ActiveClass="active" href="" Match="NavLinkMatch.All">
        <svg viewBox="0 0 15 15" fill="none"><rect x="1" y="1" width="5" height="5" rx="1.2" fill="currentColor"/><rect x="8" y="1" width="6" height="5" rx="1.2" fill="currentColor" opacity=".5"/><rect x="1" y="8" width="5" height="6" rx="1.2" fill="currentColor" opacity=".5"/><rect x="8" y="8" width="6" height="6" rx="1.2" fill="currentColor" opacity=".5"/></svg>
        Dashboard
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="module/style-sheet">
        <svg viewBox="0 0 15 15" fill="none"><rect x="1" y="2" width="13" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M4 5h7M4 7.5h5M4 10h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        Style Sheet
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="@StyleHref("module/size-chart")">
        <svg viewBox="0 0 15 15" fill="none"><rect x="1" y="3" width="13" height="1.5" rx=".75" fill="currentColor" opacity=".7"/><rect x="1" y="7" width="13" height="1.5" rx=".75" fill="currentColor" opacity=".7"/><rect x="1" y="11" width="13" height="1.5" rx=".75" fill="currentColor" opacity=".7"/><rect x="4.5" y="1" width="1.5" height="13" rx=".75" fill="currentColor" opacity=".4"/></svg>
        Size Chart
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="@StyleHref("module/block-generator")">
        <svg viewBox="0 0 15 15" fill="none"><path d="M7.5 2L13 12H2L7.5 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none" opacity=".85"/></svg>
        Block Generator
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="@StyleHref("module/grading")">
        <svg viewBox="0 0 15 15" fill="none"><circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="1.4" fill="none" opacity=".85"/><path d="M5 7.5h5M7.5 5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".5"/></svg>
        Grading
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="@StyleHref("module/pieces")">
        <svg viewBox="0 0 15 15" fill="none"><rect x="1" y="1" width="5" height="8" rx="1.2" fill="currentColor" opacity=".7"/><rect x="8" y="1" width="6" height="8" rx="1.2" fill="currentColor" opacity=".5"/><rect x="1" y="11" width="13" height="3" rx="1.2" fill="currentColor" opacity=".4"/></svg>
        Pattern Pieces
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="@StyleHref("module/library")">
        <svg viewBox="0 0 15 15" fill="none"><rect x="1" y="2" width="3" height="11" rx="1" fill="currentColor" opacity=".7"/><rect x="5" y="2" width="3" height="11" rx="1" fill="currentColor" opacity=".5"/><rect x="9" y="2" width="5" height="11" rx="1" fill="currentColor" opacity=".4"/></svg>
        Library
    </NavLink>

    <div class="sb-divider"></div>
    <div class="sb-section">Tools</div>

    <NavLink class="sb-item" ActiveClass="active" href="@CanvasHref()">
        <svg viewBox="0 0 15 15" fill="none"><rect x="1" y="1" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.4" fill="none" opacity=".85"/><path d="M4.5 8L6.5 10L10.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" opacity=".65"/></svg>
        Canvas Editor
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="@StyleHref("module/nest")">
        <svg viewBox="0 0 15 15" fill="none"><path d="M3 12V6L7.5 3L12 6V12H9V9H6V12H3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none" opacity=".75"/></svg>
        Graded Nest
    </NavLink>

    <NavLink class="sb-item" ActiveClass="active" href="@ExportHref()">
        <svg viewBox="0 0 15 15" fill="none"><path d="M7.5 2V10M4.5 7L7.5 10L10.5 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" opacity=".85"/><path d="M2 11V13H13V11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".5"/></svg>
        Export / DXF
    </NavLink>

    <div class="sb-divider"></div>
    <div class="sb-section">Account</div>
    <NavLink class="sb-item" ActiveClass="active" href="account">
        <svg viewBox="0 0 15 15" fill="none"><circle cx="7.5" cy="5" r="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 13c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        My account
    </NavLink>

    @if (_isAdmin)
    {
        <div class="sb-divider"></div>
        <div class="sb-section">Admin</div>
        <NavLink class="sb-item" ActiveClass="active" href="admin">
            <svg viewBox="0 0 15 15" fill="none"><circle cx="7.5" cy="5" r="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 13c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Admin panel
        </NavLink>
    }
</nav>

@if (_isAuthenticated)
{
    <div class="sb-footer">
        <div class="sb-avatar">@_initials</div>
        <div class="sb-footer-info">
            <div class="sb-user-name">@_displayName</div>
            <div class="sb-user-role">@_role@(string.IsNullOrWhiteSpace(_employeeId) ? "" : $" · {_employeeId}")</div>
            <div class="sb-signout-wrap">
                <button type="button" class="pp-signout-btn" @onclick="RefreshPageAsync" disabled="@_refreshing" title="Reload from database">↻ Refresh</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _refreshing;
    private string _displayName = "";
    private string _role = "";
    private string _employeeId = "";
    private string _initials = "";
    private string _styleKey = "skinny";
    private int? _patternId;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        Navigation.LocationChanged += OnLocationChanged;
        RefreshNavContext();
        await RefreshUserAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => RefreshNavContext();

    private void RefreshNavContext()
    {
        _styleKey = DesktopShellNavigation.StyleFromUri(Navigation);
        _patternId = DesktopShellNavigation.PatternIdFromUri(Navigation);
    }

    private string StyleHref(string path) =>
        DesktopShellNavigation.HrefWithStyle(path, _styleKey);

    private string CanvasHref() =>
        _patternId is int pid && pid > 0
            ? DesktopShellNavigation.HrefWithStyleAndPattern("module/canvas", _styleKey, pid)
            : StyleHref("module/canvas");

    private string ExportHref() =>
        _patternId is int pid && pid > 0
            ? DesktopShellNavigation.HrefWithStyleAndPattern("module/export", _styleKey, pid)
            : StyleHref("module/export");

    private void OnAuthChanged() => _ = RefreshUserAsync();

    private async Task RefreshUserAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _isAdmin = user.IsInRole(Pattern.Core.Model.AppRoles.Admin);
        _displayName = DesktopAuthService.DisplayName(user) ?? "";
        _employeeId = user.FindFirst("EmployeeId")?.Value ?? "";
        _role = _isAdmin ? "Administrator"
            : user.IsInRole(Pattern.Core.Model.AppRoles.Designer) ? "Pattern designer"
            : user.IsInRole(Pattern.Core.Model.AppRoles.Viewer) ? "View only" : "User";
        _initials = Initials(_displayName);
        await InvokeAsync(StateHasChanged);
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
            : name.Trim()[..Math.Min(2, name.Trim().Length)].ToUpperInvariant();
    }

    private async Task RefreshPageAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            DesktopShellRefresh.ReloadCurrentRoute(Navigation, DataRefresh, CanvasHost, Toast);
            await Task.Delay(150);
        }
        finally
        {
            _refreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
