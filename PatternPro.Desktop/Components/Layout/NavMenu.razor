@implements IDisposable
@using PatternPro.Desktop.Auth
@using PatternPro.Desktop.Services
@inject DesktopAuthService Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject DesktopToastService Toast
@inject DesktopDataRefreshService DataRefresh

<div class="pp-brand">
    <div class="pp-brand-name">PatternPro</div>
    <div class="pp-brand-sub">Desktop · Bottom wear</div>
</div>

<nav class="pp-nav">
    <div class="pp-nav-section">Workspace</div>
    <NavLink class="pp-nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>

    <div class="pp-nav-section">PLM</div>
    <NavLink class="pp-nav-link" href="module/style-sheet">Style Sheet</NavLink>
    <NavLink class="pp-nav-link" href="module/size-chart">Size Chart</NavLink>
    <NavLink class="pp-nav-link" href="module/block-generator">Block Generator</NavLink>

    <div class="pp-nav-section">Pattern</div>
    <NavLink class="pp-nav-link" href="module/grading">Grading</NavLink>
    <NavLink class="pp-nav-link" href="module/pieces">Pieces</NavLink>
    <NavLink class="pp-nav-link" href="module/canvas">Canvas</NavLink>
    <NavLink class="pp-nav-link" href="module/nest">Graded Nest</NavLink>

    <div class="pp-nav-section">Output</div>
    <NavLink class="pp-nav-link" href="module/export">Export</NavLink>
    <NavLink class="pp-nav-link" href="module/library">Library</NavLink>

    <div class="pp-nav-section">Account</div>
    <NavLink class="pp-nav-link" href="account">
        <svg viewBox="0 0 15 15" fill="none" width="15" height="15"><circle cx="7.5" cy="5" r="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 13c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        My account
    </NavLink>

    @if (_isAdmin)
    {
        <div class="pp-nav-section">Admin</div>
        <NavLink class="pp-nav-link" href="admin">
            <svg viewBox="0 0 15 15" fill="none" width="15" height="15"><path d="M7.5 1.5L2 4v3.5c0 3.2 2.3 6.2 5.5 7 3.2-.8 5.5-3.8 5.5-7V4L7.5 1.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M5.5 7.5l1.3 1.3 2.7-2.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Admin panel
        </NavLink>
    }
</nav>

@if (_isAuthenticated)
{
    <div class="pp-sidebar-footer">
        <div class="pp-user-card">
            <div class="pp-avatar">@_initials</div>
            <div class="pp-user-meta">
                <div class="pp-user-name">@_displayName</div>
                <div class="pp-user-role">@_role@(string.IsNullOrWhiteSpace(_employeeId) ? "" : $" · {_employeeId}")</div>
            </div>
        </div>
        <button type="button" class="btn btn-outline btn-sm pp-refresh" @onclick="RefreshPage" disabled="@_refreshing" title="Reload this page from the shared database">
            ↻ Refresh
        </button>
        <button type="button" class="btn btn-outline btn-sm pp-logout" @onclick="Logout">⇥ Sign out</button>
    </div>
}

@code {
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _refreshing;
    private string _displayName = "";
    private string _role = "";
    private string _employeeId = "";
    private string _initials = "";

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        await RefreshUserAsync();
    }

    private void OnAuthChanged() => _ = RefreshUserAsync();

    private async Task RefreshUserAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _isAdmin = user.IsInRole(Pattern.Core.Model.AppRoles.Admin);
        _displayName = DesktopAuthService.DisplayName(user) ?? "";
        _employeeId = user.FindFirst("EmployeeId")?.Value ?? "";
        _role = _isAdmin ? "Administrator"
            : user.IsInRole(Pattern.Core.Model.AppRoles.Designer) ? "Designer"
            : "Viewer";
        _initials = Initials(_displayName);
        await InvokeAsync(StateHasChanged);
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
            : name.Trim()[..Math.Min(2, name.Trim().Length)].ToUpperInvariant();
    }

    private void RefreshPage()
    {
        if (_refreshing) return;
        _refreshing = true;
        DataRefresh.ReloadAllFromStore();
        Toast.Show("Refreshing", "Loading latest data from the shared database…", DesktopToastType.Info, "↻");
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(relative) ? "" : relative, forceLoad: true);
    }

    private void Logout()
    {
        Auth.SignOut();
        Navigation.NavigateTo("login", replace: true);
    }

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
