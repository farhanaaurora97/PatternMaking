<ErrorBoundary @ref="_boundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="pp-error-panel">
            <div class="page-title" style="font-size:1.2rem;margin-bottom:8px">Something went wrong</div>
            <p class="pp-error-msg">@ex.Message</p>
            <div style="display:flex;gap:8px;margin-top:16px">
                <button type="button" class="btn btn-gold btn-sm" @onclick="Recover">Try again</button>
                <NavLink class="btn btn-outline btn-sm" href="">Dashboard</NavLink>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ErrorBoundary? _boundary;

    private void Recover() => _boundary?.Recover();
}
